{
  "name": "dataflow-pipeline-builder",
  "displayName": "DataFlow Pipeline Builder",
  "description": "Visual pipeline builder for DataFlow using React-Flow",
  "version": "0.0.1",
  "publisher": "antigravity",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-gtm/apache-beam-designer.git"
  },
  "bugs": {
    "url": "https://github.com/cloud-gtm/apache-beam-designer/issues"
  },
  "homepage": "https://github.com/cloud-gtm/apache-beam-designer#readme",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:dataflow-pipeline-builder.beamEditor",
    "onLanguage:beam",
    "onView:dataflowExplorer"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pipelines can be viewed and edited in untrusted workspaces. Running pipelines and generating code are disabled until the workspace is trusted."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "beam",
        "aliases": [
          "Apache Beam Pipeline",
          "beam",
          "Beam"
        ],
        "extensions": [
          ".beam"
        ],
        "mimetypes": [
          "application/x-yaml",
          "text/yaml"
        ]
      }
    ],
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.beam": "dataflow-pipeline-builder.beamEditor",
        "{**/*.beam}": "dataflow-pipeline-builder.beamEditor"
      }
    },
    "configuration": {
      "title": "DataFlow Designer",
      "properties": {
        "dataflowDesigner.gcloudPath": {
          "type": "string",
          "default": "",
          "description": "Custom absolute path to the gcloud executable. If empty, the extension searches PATH and standard installation locations."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "dataflow-pipeline-builder.beamEditor",
        "displayName": "Beam Pipeline Editor",
        "selector": [
          {
            "filenamePattern": "*.beam"
          },
          {
            "filenamePattern": "**/*.beam"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dataflow-pipeline-builder.createNewPipeline",
        "title": "Beam: New Pipeline",
        "icon": "$(plus)"
      },
      {
        "command": "dataflow-pipeline-builder.openWithDesigner",
        "title": "Open in Beam Pipeline Designer",
        "icon": "$(layout)"
      },
      {
        "command": "dataflow-pipeline-builder.showEditor",
        "title": "DataFlow: Show Editor"
      },
      {
        "command": "dataflow-pipeline-builder.refreshPipelines",
        "title": "Refresh Pipelines",
        "icon": "$(refresh)"
      },
      {
        "command": "dataflow-pipeline-builder.openJobInConsole",
        "title": "Open Job in Cloud Console"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-dataflow-designer",
          "title": "DataFlow Designer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-dataflow-designer": [
        {
          "id": "dataflowExplorer",
          "name": "DataFlow Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dataflowExplorer",
        "contents": "No Apache Beam pipeline files found in this workspace.\n[Create New Pipeline](command:dataflow-pipeline-builder.createNewPipeline)\n[Open Walkthrough](command:workbench.action.openWalkthrough?%22antigravity.dataflow-pipeline-builder%23beamWalkthrough%22)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dataflow-pipeline-builder.openWithDesigner",
          "when": "resourceExtname == .beam",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "dataflow-pipeline-builder.createNewPipeline",
          "when": "activeCustomEditorId == 'dataflow-pipeline-builder.beamEditor'",
          "group": "navigation@1"
        },
        {
          "command": "dataflow-pipeline-builder.openWithDesigner",
          "when": "resourceExtname == .beam && activeCustomEditorId != 'dataflow-pipeline-builder.beamEditor'",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "dataflow-pipeline-builder.createNewPipeline",
          "when": "view == dataflowExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dataflow-pipeline-builder.refreshPipelines",
          "when": "view == dataflowExplorer",
          "group": "navigation@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "beamWalkthrough",
        "title": "Get Started with Apache Beam Pipeline Builder",
        "description": "Learn how to visually design, configure, and generate Apache Beam data pipelines.",
        "steps": [
          {
            "id": "designDag",
            "title": "Design with Sources, Transforms & Sinks",
            "description": "Drag and drop BigQuery, PubSub, Kafka, JDBC, and transformation steps onto the canvas and connect them.",
            "media": {
              "markdown": "walkthroughs/design-dag.md"
            }
          },
          {
            "id": "generateCode",
            "title": "Generate Production Code",
            "description": "Use built-in AI code generation with Gemini to generate production-ready Java and Python pipeline code, unit tests, and Dockerfiles.",
            "media": {
              "markdown": "walkthroughs/generate-code.md"
            }
          },
          {
            "id": "createPipeline",
            "title": "Create your first pipeline",
            "description": "Start designing a new data pipeline by creating a visual `.beam` pipeline file.\n[Create New Pipeline](command:dataflow-pipeline-builder.createNewPipeline)",
            "media": {
              "markdown": "walkthroughs/create-pipeline.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "build": "npm run build:webview && npm run compile",
    "build:webview": "npm --prefix webview run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "pretest": "npm run compile && npm run typecheck:webview && npm run lint",
    "typecheck:webview": "npm --prefix webview run typecheck",
    "lint": "eslint src",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:integration:watch": "vitest --config vitest.integration.config.mts",
    "test:integration:sources": "vitest run --config vitest.integration.config.mts src/test/integration/sources",
    "test:integration:sinks": "vitest run --config vitest.integration.config.mts src/test/integration/sinks",
    "test:integration:steps": "vitest run --config vitest.integration.config.mts src/test/integration/steps",
    "test:integration:java": "vitest run --config vitest.integration.config.mts src/test/integration/**/java",
    "test:integration:python": "vitest run --config vitest.integration.config.mts src/test/integration/**/python",
    "test:integration:sources:java": "vitest run --config vitest.integration.config.mts src/test/integration/sources/java",
    "test:integration:sources:python": "vitest run --config vitest.integration.config.mts src/test/integration/sources/python",
    "test:integration:sinks:java": "vitest run --config vitest.integration.config.mts src/test/integration/sinks/java",
    "test:integration:sinks:python": "vitest run --config vitest.integration.config.mts src/test/integration/sinks/python",
    "test:integration:steps:java": "vitest run --config vitest.integration.config.mts src/test/integration/steps/java",
    "test:integration:steps:python": "vitest run --config vitest.integration.config.mts src/test/integration/steps/python",
    "test:webview": "npm --prefix webview test",
    "test:all": "npm run test:unit && npm run test:webview",
    "test:changed": "vitest run --changed --passWithNoTests && npm --prefix webview run test:changed"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.28.0",
    "eslint-plugin-jsdoc": "^48.11.0",
    "globals": "^15.15.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici-types": "^8.3.0",
    "yaml": "^2.9.0"
  }
}
