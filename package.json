{
  "name": "dataflow-pipeline-builder",
  "displayName": "DataFlow Pipeline Builder",
  "description": "Visual pipeline builder for DataFlow using React-Flow",
  "version": "0.0.1",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dataflow-pipeline-builder.beamEditor",
        "displayName": "Beam Pipeline Editor",
        "selector": [
          {
            "filenamePattern": "*.beam"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dataflow-pipeline-builder.createNewPipeline",
        "title": "Beam: New Pipeline",
        "icon": "$(plus)"
      },
      {
        "command": "dataflow-pipeline-builder.showEditor",
        "title": "DataFlow: Show Editor"
      },
      {
        "command": "dataflow-pipeline-builder.refreshPipelines",
        "title": "Refresh Pipelines",
        "icon": "$(refresh)"
      },
      {
        "command": "dataflow-pipeline-builder.openJobInConsole",
        "title": "Open Job in Cloud Console"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-dataflow-designer",
          "title": "DataFlow Designer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-dataflow-designer": [
        {
          "id": "dataflowExplorer",
          "name": "DataFlow Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dataflowExplorer",
        "contents": "No Apache Beam pipeline files found in this workspace.\n[Create New Pipeline](command:dataflow-pipeline-builder.createNewPipeline)\n[Open Walkthrough](command:workbench.action.openWalkthrough?%22antigravity.dataflow-pipeline-builder%23beamWalkthrough%22)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "dataflow-pipeline-builder.createNewPipeline",
          "when": "activeCustomEditorId == 'dataflow-pipeline-builder.beamEditor'",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "dataflow-pipeline-builder.createNewPipeline",
          "when": "view == dataflowExplorer",
          "group": "navigation@1"
        },
        {
          "command": "dataflow-pipeline-builder.refreshPipelines",
          "when": "view == dataflowExplorer",
          "group": "navigation@2"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "beamWalkthrough",
        "title": "Get Started with Apache Beam Pipeline Builder",
        "description": "Learn how to visually design, configure, and generate Apache Beam data pipelines.",
        "steps": [
          {
            "id": "designDag",
            "title": "Design with Sources, Transforms & Sinks",
            "description": "Drag and drop BigQuery, PubSub, Kafka, JDBC, and transformation steps onto the canvas and connect them.",
            "media": {
              "markdown": "walkthroughs/design-dag.md"
            }
          },
          {
            "id": "generateCode",
            "title": "Generate Production Code",
            "description": "Use built-in AI code generation with Gemini to generate production-ready Java and Python pipeline code, unit tests, and Dockerfiles.",
            "media": {
              "markdown": "walkthroughs/generate-code.md"
            }
          },
          {
            "id": "createPipeline",
            "title": "Create your first pipeline",
            "description": "Start designing a new data pipeline by creating a visual `.beam` pipeline file.\n[Create New Pipeline](command:dataflow-pipeline-builder.createNewPipeline)",
            "media": {
              "markdown": "walkthroughs/create-pipeline.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:webview && npm run compile",
    "build": "npm run build:webview && npm run compile",
    "build:webview": "npm --prefix webview run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "test:integration": "vitest run",
    "test:integration:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.28.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@google/genai": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "undici-types": "^8.3.0"
  }
}
