{
  "name": "dataflow-pipeline-builder",
  "displayName": "DataFlow Pipeline Builder",
  "description": "Visual pipeline builder for DataFlow using React-Flow",
  "version": "0.0.1",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dataflow-pipeline-builder.beamEditor",
        "displayName": "Beam Pipeline Editor",
        "selector": [
          {
            "filenamePattern": "*.beam"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dataflow-pipeline-builder.showEditor",
        "title": "DataFlow: Show Editor"
      },
      {
        "command": "dataflow-pipeline-builder.refreshPipelines",
        "title": "Refresh Pipelines",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-dataflow-designer",
          "title": "DataFlow Designer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-dataflow-designer": [
        {
          "id": "dataflowExplorer",
          "name": "DataFlow Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dataflow-pipeline-builder.refreshPipelines",
          "when": "view == dataflowExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4",
    "eslint": "^8.28.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0"
  }
}
