nodes:
  - id: "1001"
    type: pipeline
    position: { x: 80, y: 150 }
    data:
      label: Text Input
      type: SOURCE
      iconName: FileText
      beam_transform: TextIO
      properties:
        filePattern: "gs://apache-beam-samples/shakespeare/kinglear.txt"
  - id: "1002"
    type: pipeline
    position: { x: 340, y: 150 }
    data:
      label: Split Words
      type: STEP
      iconName: FileCode
      beam_transform: FlatMap
      properties:
        regex: "[a-zA-Z0-9_]+"
  - id: "1003"
    type: pipeline
    position: { x: 580, y: 150 }
    data:
      label: Count Words
      type: STEP
      iconName: BarChart
      beam_transform: Count
  - id: "1004"
    type: pipeline
    position: { x: 820, y: 150 }
    data:
      label: Write Counts
      type: SINK
      iconName: Terminal
      beam_transform: TextIO
      properties:
        filePrefix: "wordcounts"
edges:
  - id: e-1001-1002
    source: "1001"
    target: "1002"
  - id: e-1002-1003
    source: "1002"
    target: "1003"
  - id: e-1003-1004
    source: "1003"
    target: "1004"
runtimeVariables:
  - key: JOB_ID
    value: wordcount-pipeline
pipelineConfig:
  language: YAML
  outputFolder: ./wordcount-pipeline
