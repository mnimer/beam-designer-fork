nodes:
  - id: "1787600432005"
    type: pipeline
    position:
      x: 109.5
      y: 81.5
    data:
      label: trigger
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        withRateLimit: true
        periodSeconds: "1"
        start: "0"
  - id: "1787600436005"
    type: pipeline
    position:
      x: 347.5
      y: 193.1507064290317
    data:
      label: generate mock data
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        codeGenerationPrompt: >-
          Use a mock data library to generate ${NUM_OBJECTS_PER_ITERATION}
          objects for each iteration with this json template. 


          Libraries: 

          python: JSF

          java:  Datafaker (net.datafaker:datafaker >= 2.7.0)


          ```

          # Define your JSON template/schema

          schema = {
              "type": "object",
              "properties": {
                  "id": {"type": "integer", "minimum": 1, "maximum": 100},
                  "name": {"type": "string", "$provider": "faker.name"},
                  "email": {"type": "string", "$provider": "faker.email"},
                  "signup_date": {"type": "string", "$provider": "faker.date"}
              },
              "required": ["id", "name", "email"]
          }


          ```
      system_instructions: Wrap the generated code in a try/catch, returning all
        errors to a separate pcollection
  - id: "1787600440963"
    type: pipeline
    position:
      x: 680
      y: 150
    data:
      label: Log Message
      type: STEP
      iconName: Terminal
      beam_transform: LogMessage
