.vscode/**
.vscode-test/**
.github/**
.agents/**
.gemini/**
src/**
tsconfig.json
**/*.map
.gitignore
.eslintignore
.eslintrc*
eslint.config.*
skills-lock.json
ARCHITECTURE.md
DESIGN.md
TASK.md
vitest*.config.*
**/*.log
**/.test-report.*

# Webview source & tooling (keep only webview/dist/**)
webview/src/**
webview/node_modules/**
webview/public/**
webview/tsconfig*.json
webview/vite.config.*
webview/vitest.config.*
webview/eslint.config.*
webview/index.html
webview/package*.json
webview/README.md

# Ensure critical runtime directories are included
!out/**
!webview/dist/**
!resources/**
# Exclude test output and source maps
out/test/**
**/*.map

# Prune non-runtime files from node_modules
**/node_modules/**/test/**
**/node_modules/**/tests/**
**/node_modules/**/__tests__/**
**/node_modules/**/.github/**
**/node_modules/**/*.md
**/node_modules/**/*.d.ts
**/node_modules/**/*.map
**/node_modules/**/LICENSE*
**/node_modules/**/CHANGELOG*
**/node_modules/**/.eslintrc*
**/node_modules/**/.prettier*
**/node_modules/**/tsconfig*.json
