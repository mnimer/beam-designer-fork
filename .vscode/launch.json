{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--inspect-extensions=9229"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (Debug)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--inspect-extensions=9229"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Run Extension (No Debug)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Attach to Extension Host",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "127.0.0.1",
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Launch & Debug Extension",
      "configurations": [
        "Run Extension (Debug)",
        "Attach to Extension Host"
      ]
    }
  ]
}
