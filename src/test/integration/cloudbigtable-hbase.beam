# ==============================================================================
# IO68: Cloud Bigtable (HBase based) — hot table to archive table (Java)
# ==============================================================================
# Author: Mike Nimer <mikenimer@google.com>
# Purpose: Pipeline specification for IO68 CloudBigtable Source -> ParDo -> CloudBigtable Sink
#          using the HBase-based connector (com.google.cloud.bigtable:bigtable-hbase-beam).
#          The source authenticates with ADC; the cross-project sink authenticates with a
#          service-account JSON key resolved from Secret Manager (credentialsSecret).
nodes:
  - id: "source-bigtable-hbase-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: "Read User Events (Bigtable HBase)"
      type: SOURCE
      iconName: Database
      beam_transform: CloudBigtable
      properties:
        projectId: "my-gcp-project"
        instanceId: "events-instance"
        tableId: "user-events"
        appProfileId: "batch-analytics"
        rowPrefix: "2026-09#"
        columnFamilies: "events"
        maxVersions: "1"
      system_instructions: "Use the HBase-based Cloud Bigtable connector from Maven artifact com.google.cloud.bigtable:bigtable-hbase-beam (package com.google.cloud.bigtable.beam), NOT org.apache.beam.sdk.io.gcp.bigtable.BigtableIO. Build an org.apache.hadoop.hbase.client.Scan with setRowPrefixFilter(Bytes.toBytes(rowPrefix)), addFamily(Bytes.toBytes(columnFamilies)), setMaxVersions(maxVersions) and setCacheBlocks(false); pass it to new CloudBigtableScanConfiguration.Builder().withProjectId(projectId).withInstanceId(instanceId).withTableId(tableId).withAppProfileId(appProfileId).withScan(scan).build() and apply Read.from(CloudBigtableIO.read(config)) to produce PCollection<org.apache.hadoop.hbase.client.Result>. This node has no credential properties: authenticate with Application Default Credentials."
    width: 220
    height: 64
    selected: false
    dragging: false
  - id: "step-pardo-archive-2"
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: "Convert Result to Archive Put"
      type: STEP
      iconName: Code
      beam_transform: ParDo
      system_instructions: "Implement a static nested DoFn<Result, Mutation> that converts each HBase Result into an org.apache.hadoop.hbase.client.Put for the archive table: skip results where result.isEmpty(); use result.getRow() as the row key; for every Cell in result.rawCells() add the value to column family 'archive' with the same qualifier and original timestamp (CellUtil.cloneQualifier, cell.getTimestamp(), CellUtil.cloneValue); add column 'meta':'archived_at' holding the current epoch milliseconds as Bytes.toBytes(String). Only Put mutations are emitted (CloudBigtableIO writes support Put and Delete only, never Append or Increment). Factor the conversion into a static helper method and unit-test it with TestPipeline, Create.of and PAssert without connecting to Bigtable."
    width: 220
    height: 64
    selected: false
    dragging: false
  - id: "sink-bigtable-hbase-3"
    type: pipeline
    position:
      x: 680
      y: 150
    data:
      label: "Write Archive (Bigtable HBase)"
      type: SINK
      iconName: Database
      beam_transform: CloudBigtable
      properties:
        projectId: "archive-gcp-project"
        instanceId: "archive-instance"
        writeMode: "singleTable"
        tableId: "user-events-archive"
        bulkMutationFlowControl: true
        configuration:
          - key: "google.bigtable.bulk.max.row.key.count"
            value: "500"
          - key: "google.bigtable.bulk.autoflush.ms"
            value: "1000"
        credentialsSecret: "bigtable-archive-sa-key"
      system_instructions: "Write with CloudBigtableIO.writeToTable(config) (writeMode = singleTable) from com.google.cloud.bigtable:bigtable-hbase-beam, where config = new CloudBigtableTableConfiguration.Builder().withProjectId(projectId).withInstanceId(instanceId).withTableId(tableId).withConfiguration(\"google.bigtable.enable.bulk.mutation.flow.control\", String.valueOf(bulkMutationFlowControl)) plus one .withConfiguration(key, value) call per configuration entry. credentialsSecret is the Secret Manager short ID of a service-account JSON key for the archive project: resolve it ONCE in main with accessSecret(options.getProject(), credentialsSecret) and pass the payload via .withConfiguration(\"google.bigtable.auth.json.value\", serviceAccountJson). Never log, print or write the key to any file, script or metadata.json."
    width: 220
    height: 64
    selected: false
    dragging: false
edges:
  - id: "e-source-to-pardo"
    source: "source-bigtable-hbase-1"
    target: "step-pardo-archive-2"
  - id: "e-pardo-to-sink"
    source: "step-pardo-archive-2"
    target: "sink-bigtable-hbase-3"
runtimeVariables:
  - key: JOB_ID
    value: "bigtable-hbase-archive"
jobConfig:
  runner: "DirectRunner"
  machineType: "n1-standard-2"
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: "Java"
  outputFolder: "test/cloudbigtable-hbase"
  needsRebuild: false
