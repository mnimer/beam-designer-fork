nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - apple
          - banana
          - apple
          - orange
          - banana
          - grape
          - apple
    width: 180
    height: 62
  - id: step-distinct
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: Distinct
      type: STEP
      iconName: BarChart
      beam_transform: Distinct
      properties: {}
    width: 180
    height: 62
  - id: step-sample
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Sample
      type: STEP
      iconName: BarChart
      beam_transform: Sample
      properties:
        sampleSize: 3
    width: 180
    height: 62
  - id: step-approx-unique
    type: pipeline
    position:
      x: 760
      y: 150
    data:
      label: Approximate Unique
      type: STEP
      iconName: BarChart
      beam_transform: ApproximateUnique
      properties:
        sampleSize: 100
    width: 180
    height: 62
  - id: step-latest
    type: pipeline
    position:
      x: 980
      y: 150
    data:
      label: Latest
      type: STEP
      iconName: BarChart
      beam_transform: Latest
      properties: {}
    width: 180
    height: 62
  - id: sink-log
    type: pipeline
    position:
      x: 1200
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[Distinct-Sample]"
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-distinct
    source: source-1
    target: step-distinct
  - id: edge-step-distinct-to-step-sample
    source: step-distinct
    target: step-sample
  - id: edge-step-sample-to-step-approx-unique
    source: step-sample
    target: step-approx-unique
  - id: edge-step-approx-unique-to-step-latest
    source: step-approx-unique
    target: step-latest
  - id: edge-step-latest-to-sink-log
    source: step-latest
    target: sink-log
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: distinct-sampling-approximate-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/distinct-sampling-approximate-java
  needsRebuild: false
