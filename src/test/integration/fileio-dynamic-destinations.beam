# ==============================================================================
# I11: FileIO Dynamic Destinations (Java & Python)
# Java Generation & Evaluation: ✅ PASS (100 / 100)
# Explanation: The pipeline accurately parses file inputs, extracts partitioning keys via ParDo, and dynamically writes to partitioned GCS destinations with custom naming via FileIO.writeDynamic().
# Python Generation & Evaluation: ✅ PASS (100 / 100)
# Explanation: File partitioning and dynamic destination routing using Python FileIO and custom sinks are properly implemented with isolated partitioned outputs.
# ==============================================================================
# Author: Mike Nimer <mikenimer@google.com>
#
# Dynamic file partitioning: FileIO file-pattern reader -> ParDo dynamic partition categorization -> FileIO dynamic destinations.

nodes:
  - id: "source-fileio-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: "FileIO Read"
      type: SOURCE
      iconName: FolderArchive
      beam_transform: FileIO
      properties:
        filePattern: "gs://my-bucket/incoming/*.csv"
      system_instructions: "Read files matching 'gs://my-bucket/incoming/*.csv' using FileIO.match() and FileIO.readMatches()."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-pardo-partition-2"
    type: pipeline
    position:
      x: 360
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        partitionField: "country"
        codeGenerationPrompt: "Extract partition key by date and country from incoming CSV lines for dynamic destination routing."
      system_instructions: "Extract partition key based on date and country field ('country') to route records into partitioned directories."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-fileio-3"
    type: pipeline
    position:
      x: 640
      y: 150
    data:
      label: "FileIO Write Dynamic"
      type: SINK
      iconName: FolderArchive
      beam_transform: FileIO
      properties:
        baseOutputDirectory: "gs://my-bucket/partitioned/"
        partitionField: "country"
        writeDisposition: "writeDynamic"
      system_instructions: "Dynamically partition and write records to 'gs://my-bucket/partitioned/' using FileIO.writeDynamic() partitioned by country."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "edge-source-to-pardo"
    source: "source-fileio-1"
    target: "step-pardo-partition-2"
  - id: "edge-pardo-to-sink"
    source: "step-pardo-partition-2"
    sourceHandle: valid
    target: "sink-fileio-3"
    targetHandle: null
runtimeVariables:
  - key: JOB_ID
    value: fileio-dynamic-destinations
  - key: filePattern
    value: "gs://my-bucket/incoming/*.csv"
  - key: baseOutputDirectory
    value: "gs://my-bucket/partitioned/"
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: "gs://my-bucket/staging"
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: "test/fileio-dynamic-destinations"
  needsRebuild: false
