# Author: Mike Nimer <mikenimer@google.com>
#
# Pipeline Specification: I8 - SqsIO to SnsIO Filtered Pipeline
# DAG: SqsIO Source ➔ Filter (priority messages) ➔ ParDo (enrichment) ➔ SnsIO Sink

nodes:
  - id: "source-sqs-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: SQS
      type: SOURCE
      iconName: Cable
      beam_transform: SqsIO
      properties:
        queueUrl: "https://sqs.us-east-1.amazonaws.com/123456789012/input-queue"
        maxNumRecords: 100
        awsRegion: "us-east-1"
      system_instructions: "Read incoming message records from Amazon SQS queue 'https://sqs.us-east-1.amazonaws.com/123456789012/input-queue' with maxNumRecords 100 in AWS region us-east-1."
    width: 180
    height: 62
  - id: "step-filter-2"
    type: pipeline
    position:
      x: 340
      y: 150
    data:
      label: Filter
      type: STEP
      iconName: Filter
      beam_transform: Filter
      properties:
        predicate: "record.priority == 'HIGH'"
        compareTarget: "Message Property"
        property: "priority"
        operator: "=="
        value: "HIGH"
      system_instructions: "Filter messages using predicate 'record.priority == \\'HIGH\\'', retaining only high-priority messages."
    width: 180
    height: 62
  - id: "step-pardo-enrich-3"
    type: pipeline
    position:
      x: 600
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        codeGenerationPrompt: "Enrich high-priority records with processing timestamp and alert metadata for SNS publishing."
      system_instructions: "Enrich incoming high-priority alert records with processing timestamps and structure payload for Amazon SNS topic publishing."
    width: 180
    height: 62
  - id: "sink-sns-4"
    type: pipeline
    position:
      x: 860
      y: 150
    data:
      label: SNS
      type: SINK
      iconName: Cable
      beam_transform: SnsIO
      properties:
        topicArn: "arn:aws:sns:us-east-1:123456789012:priority-alerts"
        awsRegion: "us-east-1"
      system_instructions: "Publish enriched high-priority alert notifications to Amazon SNS topic 'arn:aws:sns:us-east-1:123456789012:priority-alerts'."
    width: 180
    height: 62
edges:
  - id: edge-sqs-to-filter
    source: "source-sqs-1"
    target: "step-filter-2"
  - id: edge-filter-to-pardo
    source: "step-filter-2"
    sourceHandle: valid
    target: "step-pardo-enrich-3"
  - id: edge-pardo-to-sns
    source: "step-pardo-enrich-3"
    sourceHandle: valid
    target: "sink-sns-4"
runtimeVariables:
  - key: JOB_ID
    value: sqs-to-sns-filtered
  - key: SQS_QUEUE_URL
    value: "https://sqs.us-east-1.amazonaws.com/123456789012/input-queue"
  - key: SNS_TOPIC_ARN
    value: "arn:aws:sns:us-east-1:123456789012:priority-alerts"
  - key: AWS_REGION
    value: "us-east-1"
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: test/sqs-to-sns-filtered
  needsRebuild: false
