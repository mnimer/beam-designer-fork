# Author: Mike Nimer <mikenimer@google.com>
# Purpose: Pipeline specification for I15 User Session Windowing & Early Triggers (PubSubIO to BigQueryIO)
nodes:
  - id: "source-pubsub-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: "PubSub"
      type: SOURCE
      iconName: Cable
      beam_transform: PubSubIO
      properties:
        subscription: "projects/my-project/subscriptions/user-clicks"
        timestampAttribute: "timestamp"
      system_instructions: "Read streaming click events from Cloud Pub/Sub subscription 'projects/my-project/subscriptions/user-clicks' with event timestamp attribute 'timestamp'."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-timestamps-2"
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: "WithTimestamps"
      type: STEP
      iconName: Clock
      beam_transform: WithTimestamps
      properties:
        timestampType: "Event Time"
        timestampAttribute: "timestamp"
      system_instructions: "Assign explicit event time to incoming click elements based on the payload or attribute timestamp for windowing calculations."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-kvmapper-3"
    type: pipeline
    position:
      x: 560
      y: 150
    data:
      label: "KVMapper"
      type: STEP
      iconName: KeyRound
      beam_transform: KVMapper
      properties:
        keyPropertyName: "userId"
        valuePropertyName: ""
      system_instructions: "Extract userId from click event payload and map element into a Key-Value pair KV('userId', element) for keyed session windowing."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-window-4"
    type: pipeline
    position:
      x: 800
      y: 150
    data:
      label: "WindowInto"
      type: STEP
      iconName: Layers
      beam_transform: WindowInto
      properties:
        windowType: "Session Window"
        sessionGapDuration: 10
        sessionGapDurationUnit: "Minutes"
        gapDurationMinutes: 10
        earlyFiringMinutes: 1
        allowedLatenessMinutes: 5
        accumulationMode: "ACCUMULATING_FIRED_PANES"
      system_instructions: "Apply Session Windows with a 10-minute gap duration (Sessions.withGapDuration(Duration.standardMinutes(10)) in Java or window.Sessions(10 * 60) in Python). Configure triggering with AfterWatermark.pastEndOfWindow().withEarlyFirings(AfterProcessingTime.pastFirstElementInPane().plusDelayOf(Duration.standardMinutes(1))), allowed lateness of 5 minutes (allowedLatenessMinutes: 5), and accumulating fired panes."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-count-5"
    type: pipeline
    position:
      x: 1040
      y: 150
    data:
      label: "Count"
      type: STEP
      iconName: BarChart
      beam_transform: Count
      properties:
        countType: "perKey"
      system_instructions: "Count the number of user click interactions within each session using Count.perKey() (Java) or beam.combiners.Count.PerKey() (Python)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-bigquery-6"
    type: pipeline
    position:
      x: 1280
      y: 150
    data:
      label: "BigQuery"
      type: SINK
      iconName: Database
      beam_transform: BigQueryIO
      properties:
        dataset: "clickstream"
        table: "my-project:clickstream.session_counts"
        createDisposition: "beam.io.BigQueryDisposition.CREATE_IF_NEEDED"
        writeDisposition: "beam.io.BigQueryDisposition.WRITE_APPEND"
        method: "STORAGE_WRITE_API"
      system_instructions: "Write session counts per user with window metadata into BigQuery table 'my-project:clickstream.session_counts' in dataset 'clickstream' using the Storage Write API."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "e-pubsub-to-ts"
    source: "source-pubsub-1"
    target: "step-timestamps-2"
  - id: "e-ts-to-kv"
    source: "step-timestamps-2"
    sourceHandle: valid
    target: "step-kvmapper-3"
  - id: "e-kv-to-win"
    source: "step-kvmapper-3"
    sourceHandle: valid
    target: "step-window-4"
  - id: "e-win-to-count"
    source: "step-window-4"
    sourceHandle: valid
    target: "step-count-5"
  - id: "e-count-to-bq"
    source: "step-count-5"
    sourceHandle: valid
    target: "sink-bigquery-6"
runtimeVariables:
  - key: JOB_ID
    value: "pubsub-session-windows"
  - key: PROJECT_ID
    value: "my-project"
jobConfig:
  runner: "DataflowRunner"
  machineType: "n1-standard-2"
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: "gs://my-bucket/staging"
  network: ""
  subnetwork: ""
pipelineConfig:
  language: "Java"
  outputFolder: "test/pubsub-session-windows"
  needsRebuild: false
