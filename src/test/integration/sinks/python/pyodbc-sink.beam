nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"order_id": 2001, "customer_id": "cust-10", "order_total": 250.75,
            "order_status": "shipped", "updated_at": "2026-09-01T15:30:00Z"}'
          - '{"order_id": 2002, "customer_id": "cust-20", "order_total": 99.0,
            "order_status": "processing", "updated_at": "2026-09-01T15:35:00Z"}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      system_instructions: Parse each input JSON string (or dict) and normalize into a
        dict with fields order_id (int), customer_id (str), order_total (float
        rounded to 2 decimals), order_status (upper-cased str), updated_at
        (ISO-8601 UTC string). Unit-test the DoFn with TestPipeline, beam.Create
        and assert_that/equal_to.
    width: 190
    height: 64
  - id: sink-3
    type: pipeline
    position:
      x: 660
      y: 150
    data:
      label: Pyodbc
      type: SINK
      iconName: Database
      beam_transform: Pyodbc
      properties:
        driver: ODBC Driver 18 for SQL Server
        host: 10.20.0.9
        port: 1433
        database: orders_reporting
        user: beam_writer
        passwordSecret: orders-reporting-writer-password
        extraAttributes: Encrypt=yes;TrustServerCertificate=no
        table: dbo.orders_daily
        batchSize: 500
      system_instructions: "There is no built-in Beam transform for Pyodbc, so
        implement this sink with the pyodbc library: group the elements with
        beam.BatchElements(min_batch_size=1, max_batch_size=batchSize), then
        write each batch in a custom DoFn. Build the ODBC connection string with
        DRIVER={<driver>}, SERVER=<host>,<port>, DATABASE=<database>,
        UID=<user>, PWD from the passwordSecret secret via _access_secret, then
        extraAttributes. Open the connection in setup() with autocommit=False
        and close it in teardown(). For each batch, set cursor.fast_executemany
        = True and call cursor.executemany with the parameterized statement
        INSERT INTO dbo.orders_daily (order_id, customer_id, order_total,
        order_status, updated_at) VALUES (?, ?, ?, ?, ?), then commit. If the
        batch fails, roll back and re-raise. Never build SQL by
        string-formatting row values. Add pyodbc and google-cloud-secret-manager
        to requirements.txt, and install unixodbc and msodbcsql18 in the
        Dockerfile."
    width: 190
    height: 64
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: python
  - key: JOB_ID
    value: pyodbc-sink-python
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/python
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Python
  outputFolder: pipelines/python/pyodbc-sink-python
  needsRebuild: false
