nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        from: 1
        to: 500
        ratePerSec: 20
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo Mock Generator
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform integer sequence elements into mock records
        formatted for destination sink.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: AMQP
      type: SINK
      iconName: Cable
      beam_transform: AmqpIO
      properties:
        address: amqp://broker.internal:5672/orders.processed
        subject: orders.processed
        bodyType: json
        contentEncoding: json
        durable: true
        priority: 4
        ttlMillis: 86400000
        username: beam-worker
        passwordSource: secretManager
        secretName: amqp-broker-password
        expansionServiceMode: auto
        expansionServiceEndpoint: ''
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: amqp-sink-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ''
  subnetwork: ''
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/amqp-sink-java
  needsRebuild: false
