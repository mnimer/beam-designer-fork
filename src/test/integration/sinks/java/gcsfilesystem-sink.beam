nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"event_id": "e1", "status": "OK", "timestamp": 1700000000}'
          - '{"event_id": "e2", "status": "OK", "timestamp": 1700000060}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate and normalize each JSON event string and emit the
        formatted String for GcsFileSystem TextIO output.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: GcsFileSystem Write
      type: SINK
      iconName: Cloud
      beam_transform: GcsFileSystem
      properties:
        to: gs://my-bucket/output/events
        suffix: .json
        projectId: my-gcp-project
        enablePerformanceMetrics: true
        writeTimeoutMs: 20000
        uploadBufferSizeBytes: 8388608
        format: TextIO
        compression: GZIP
        numShards: "5"
        shardTemplate: -SSSSS-of-NNNNN
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: gcsfilesystem-sink-java
  - key: INPUT_GCS_PATTERN
    value: gs://my-bucket/events/*.json
  - key: OUTPUT_GCS_PREFIX
    value: gs://my-bucket/output/events
  - key: GCP_PROJECT_ID
    value: my-gcp-project
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/gcsfilesystem-sink-java
  needsRebuild: false
