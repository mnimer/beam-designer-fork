nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: Clock
      beam_transform: GenerateSequence
      properties:
        from: 0
        to: 100
        rateElements: 10
        rateSeconds: 1
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: Compute Mid Price
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        bidField: BID
        askField: ASK
        outputField: MID
      system_instructions: Implement a static nested DoFn<Long, MarketPriceMessage>
        named ComputeMidFn that synthesizes MarketPriceMessage instances (from
        com.refinitiv.beamio.trepwebsockets.MarketPriceMessage; add
        com.refinitiv.beamio:trepws-io:1.2.0 to pom.xml with
        com.google.cloud.dataflow:google-cloud-dataflow-java-sdk-all excluded)
        with RIC name "EUR=", service "DDS_TRCE", and fields map containing
        outputField ("MID") = String.valueOf((1.0800 + (element % 20) *
        0.0002)). Register SerializableCoder.of(MarketPriceMessage.class) and
        unit-test with TestPipeline, Create.of(...) and PAssert.
    width: 190
    height: 64
  - id: sink-3
    type: pipeline
    position:
      x: 660
      y: 150
    data:
      label: Post Mid to ADS Contribution
      type: SINK
      iconName: Radio
      beam_transform: TrepWsIO
      properties:
        hostname: ads-contrib.acme.internal
        port: 15000
        username: beam-poster
        appId: "256"
        serviceName: DDS_TRCE
        postMode: offStream
        ricMode: fromElement
        ricField: name
        fieldNames: MID
        ackRequired: true
        nakHandling: log
      system_instructions: 'Upstream TrepWsIO is read-only, so implement this sink as
        a custom static nested DoFn<MarketPriceMessage, Void> named
        TrepWebSocketPostFn over the documented Refinitiv WebSocket API, using
        only the JDK java.net.http WebSocket client
        (HttpClient.newHttpClient().newWebSocketBuilder().subprotocols("tr_json2"))
        and Jackson for JSON; add no other WebSocket library. Keep the WebSocket
        in a transient field; open it in @Setup to ws://hostname:port/WebSocket
        and send the Login request
        {"ID":1,"Domain":"Login","Key":{"Name":username,"Elements":{"ApplicationId":appId,"Position":<local
        host IP>}}}; close it in @Teardown. Reply to every {"Type":"Ping"} with
        {"Type":"Pong"}. postMode offStream means each element is posted on the
        Login stream:
        {"ID":1,"Type":"Post","Ack":true,"PostID":<incrementing>,"Key":{"Service":serviceName,"Name":<RIC>},"Message":{"ID":0,"Type":"Update","Domain":"MarketPrice","Fields":{...}}}.
        ricMode fromElement with ricField "name" means the RIC is
        MarketPriceMessage.getName(); fieldNames "MID" means only the MID field
        is posted. ackRequired true means track each PostID until its Ack;
        nakHandling "log" means log an Ack carrying a NakCode with LOG.warn and
        continue. This ADS login uses a DACS user name only, so no credential is
        required for this node.'
    width: 190
    height: 64
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: trepwsio-sink-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/trepwsio-sink-java
  needsRebuild: false
