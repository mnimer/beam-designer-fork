nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: ProcessFileContentFn
      system_instructions: Transform upstream JSON batch records into destination
        records required by MongoDbGridFSIO. Process parsed document contents,
        extract metadata summary, apply content normalization and redaction, and
        produce processed binary payloads ready for GridFS archival storage. In
        Java, implement as a DoFn<ParsedDocument, ProcessedFile>; in Python,
        implement as a beam.DoFn converting input dictionaries into archive file
        payloads.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: GridFS Sink
      type: SINK
      iconName: HardDrive
      beam_transform: MongoDbGridFSIO
      properties:
        uri: mongodb://mongodb.default.svc.cluster.local:27017
        database: content_repository
        bucket: processed_archives
        filename: processed_archive_%d.dat
        chunkSize: 524288
        writeFn: com.example.ArchiveWriteFn
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: mongodbgridfs-sink-java
  - key: uri
    value: mongodb://mongodb.default.svc.cluster.local:27017
  - key: database
    value: content_repository
  - key: sourceBucket
    value: raw_files
  - key: sinkBucket
    value: processed_archives
  - key: chunkSize
    value: 524288
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/mongodbgridfs-sink-java
  needsRebuild: false
