nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        from: 1
        to: 500
        ratePerSec: 20
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo Mock Generator
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform upstream sequence integers into destination
        records required by RedisIO. Transform each incoming KV<String, String>
        element representing a user score. Parse the score value, calculate a
        derived leaderboard score by applying a weight multiplier, and emit a
        transformed KV<String, String> with key prefix 'leaderboard:' and the
        updated score string. In Java, apply a DoFn<KV<String, String>,
        KV<String, String>>. In Python, use beam.ParDo or beam.Map.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Redis
      type: SINK
      iconName: Zap
      beam_transform: RedisIO
      properties:
        host: 127.0.0.1
        port: 6379
        database: 0
        writeMethod: SET
        expireTime: 86400000
        keyPrefix: "leaderboard:"
        batchSize: 500
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: redis-sink-java
  - key: host
    value: 127.0.0.1
  - key: port
    value: 6379
  - key: keyPattern
    value: user:score:*
  - key: expireTime
    value: 86400000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/redis-sink-java
  needsRebuild: false
