nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"rowKey": "2026-09#user-101", "qualifier": "login", "value": "ok",
            "timestamp": 1727481600000}'
          - '{"rowKey": "2026-09#user-102", "qualifier": "purchase", "value":
            "49.99", "timestamp": 1727481660000}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: Convert JSON to Archive Put
      type: STEP
      iconName: Code
      beam_transform: ParDo
      system_instructions: Implement a static nested DoFn<String, Mutation> that
        parses each input JSON record and constructs an
        org.apache.hadoop.hbase.client.Put for the archive table using rowKey as
        Bytes.toBytes(rowKey), adding column family 'archive' with the given
        qualifier, timestamp and value (Bytes.toBytes), plus column
        'meta':'archived_at' holding the current epoch milliseconds as
        Bytes.toBytes(String). Only Put mutations are emitted (CloudBigtableIO
        writes support Put and Delete only, never Append or Increment). Factor
        the conversion into a static helper method and unit-test it with
        TestPipeline, Create.of and PAssert without connecting to Bigtable.
    width: 190
    height: 64
  - id: sink-3
    type: pipeline
    position:
      x: 660
      y: 150
    data:
      label: Write Archive (Bigtable HBase)
      type: SINK
      iconName: Database
      beam_transform: CloudBigtable
      properties:
        projectId: archive-gcp-project
        instanceId: archive-instance
        writeMode: singleTable
        tableId: user-events-archive
        bulkMutationFlowControl: true
        configuration:
          - key: google.bigtable.bulk.max.row.key.count
            value: "500"
          - key: google.bigtable.bulk.autoflush.ms
            value: "1000"
        credentialsSecret: bigtable-archive-sa-key
      system_instructions: 'Write with CloudBigtableIO.writeToTable(config) (writeMode
        = singleTable) from com.google.cloud.bigtable:bigtable-hbase-beam, where
        config = new
        CloudBigtableTableConfiguration.Builder().withProjectId(projectId).withInstanceId(instanceId).withTableId(tableId).withConfiguration("google.bigtable.enable.bulk.mutation.flow.control",
        String.valueOf(bulkMutationFlowControl)) plus one
        .withConfiguration(key, value) call per configuration entry.
        credentialsSecret is the Secret Manager short ID of a service-account
        JSON key for the archive project: resolve it ONCE in main with
        accessSecret(options.getProject(), credentialsSecret) and pass the
        payload via .withConfiguration("google.bigtable.auth.json.value",
        serviceAccountJson). Never log, print or write the key to any file,
        script or metadata.json.'
    width: 190
    height: 64
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: cloudbigtable-hbase-sink-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/cloudbigtable-hbase-sink-java
  needsRebuild: false
