nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: aggregate_and_shape_rollup
      system_instructions: Transform upstream JSON batch records into destination
        records required by SingleStoreDBIO. Process each SensorReading entity,
        extract sensorId and reading values, compute hourly summary metrics, and
        construct new SensorRollup records. In Java, implement
        DoFn<SensorReading, SensorRollup> to map metrics into SensorRollup
        instances. In Python, apply beam.DoFn or Map transform to reshape
        reading records into destination rollup dictionaries.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: SingleStoreDB
      type: SINK
      iconName: Database
      beam_transform: SingleStoreDBIO
      properties:
        endpoint: 127.0.0.1:3306
        database: telemetry_db
        table: sensor_rollups
        userDataMapper: com.example.SensorRollupUserDataMapper
        batchSize: 10000
        authMode: none
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: singlestoredb-sink-java
  - key: endpoint
    value: 127.0.0.1:3306
  - key: database
    value: telemetry_db
  - key: sourceTable
    value: sensor_readings
  - key: targetTable
    value: sensor_rollups
  - key: batchSize
    value: 10000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/singlestoredb-sink-java
  needsRebuild: false
