nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: reshape_events
      system_instructions: Transform upstream JSON batch records into destination
        records required by ElasticsearchIO. Parse and reshape each raw
        Elasticsearch JSON hit document into an aggregated document ready for
        bulk re-indexing. In Java, parse the incoming JSON string with Jackson
        or org.json, enrich the document with an 'ingestion_timestamp' and
        'status' = 'PROCESSED', generate a deterministic document id, and emit
        the formatted JSON string. In Python, use a beam.DoFn converting the raw
        JSON string into a Python dict, modifying fields, and outputting the
        serialized JSON string.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Elasticsearch
      type: SINK
      iconName: Layers
      beam_transform: ElasticsearchIO
      properties:
        addresses: http://localhost:9200
        index: processed_events
        maxBatchSize: 1000
        maxBatchSizeBytes: 5242880
        usePartialUpdate: false
        idFn: id
        throwWriteErrors: true
        authMode: none
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: elasticsearch-sink-agent-engine
  - key: addresses
    value: http://localhost:9200
  - key: sourceIndex
    value: raw_events
  - key: destinationIndex
    value: processed_events
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/elasticsearch-sink-agent-engine
  needsRebuild: false
