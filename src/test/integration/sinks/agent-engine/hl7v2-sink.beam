nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        from: 1
        to: 500
        ratePerSec: 20
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo Mock Generator
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform integer sequence elements into mock HL7v2Message
        ADT instances with normalized MSH and PID segments for downstream
        ingestion.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: HL7v2IO Sink
      type: SINK
      iconName: Activity
      beam_transform: HL7v2IO
      properties:
        writeMethod: INGEST
        healthcareDataset: projects/healthcare-project/locations/us-central1/datasets/hl7v2-dataset
        hl7v2Store: projects/healthcare-project/locations/us-central1/datasets/hl7v2-dataset/hl7V2Stores/curated-adt-store
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: hl7v2-sink-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/hl7v2-sink-agent-engine
  needsRebuild: false
