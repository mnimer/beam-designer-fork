nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: filter_and_aggregate
      system_instructions: Transform upstream JSON batch records into destination
        records required by ArrowFlightIO. Process each telemetry Beam Row
        record, filter anomalies where temperature exceeds threshold, enrich
        with calculated window aggregates, and output formatted destination Row
        records with consistent Beam Schema. In Java, implement DoFn<Row, Row>.
        In Python, apply beam.DoFn or FlatMap/Map to transform incoming records
        into enriched output dictionary rows.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Arrow Flight Sink
      type: SINK
      iconName: Cable
      beam_transform: ArrowFlightIO
      properties:
        host: flight-sink.internal
        port: 47470
        useTls: true
        descriptor: telemetry_clean_summary
        batchSize: 1024
        authMode: secret_manager
        tokenSecret: flight-sink-token
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: arrowflight-sink-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/arrowflight-sink-agent-engine
  needsRebuild: false
