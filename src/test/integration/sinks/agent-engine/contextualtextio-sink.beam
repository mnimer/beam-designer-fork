nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - 1 | app.log | ERROR Database connection timeout
          - 2 | app.log | ERROR Disk quota exceeded
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate and normalize each formatted log report line and
        emit it as a String for TextIO.write().
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: ContextualTextIO Write Errors
      type: SINK
      iconName: FileText
      beam_transform: ContextualTextIO
      properties:
        to: gs://my-bucket/logs/filtered-errors/output
        suffix: .txt
        delimiter: |+
          
        header: LineNumber | File | Message
        footer: --- End of Error Report ---
        compression: UNCOMPRESSED
        numShards: 1
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: contextualtextio-sink-agent-engine
  - key: filePattern
    value: gs://my-bucket/logs/application-*.log
  - key: output
    value: gs://my-bucket/logs/filtered-errors/output
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/contextualtextio-sink-agent-engine
  needsRebuild: false
