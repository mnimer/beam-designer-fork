nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        from: 1
        to: 500
        ratePerSec: 20
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo Mock Generator
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform integer sequence elements into mock records
        formatted for destination sink.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Kinesis
      type: SINK
      iconName: Cloud
      beam_transform: KinesisIO
      properties:
        streamName: telemetry-out-stream
        awsRegion: us-east-1
        partitionKey: device_id
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: kinesis-sink-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/kinesis-sink-agent-engine
  needsRebuild: false
