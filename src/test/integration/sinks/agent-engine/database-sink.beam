nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: normalize_and_reformat
      system_instructions: Transform upstream JSON batch records into destination
        records required by DatabaseIO. Transform incoming PostgreSQL user
        records to target MySQL account format. Normalize email casing to
        lowercase, cast boolean active flag to TINYINT integer (1/0) for MySQL
        schema compatibility, and format timestamp string into ISO format.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Database
      type: SINK
      iconName: Database
      beam_transform: DatabaseIO
      properties:
        engine: mysql
        url: jdbc:mysql://localhost:3306/dest_db
        driverClassName: com.mysql.cj.jdbc.Driver
        table: accounts
        statementMode: custom
        statement: INSERT INTO accounts (account_id, username, email_address, is_active,
          created_at) VALUES (?, ?, ?, ?, ?)
        batchSize: 1000
        autocommit: true
        maxRetries: 3
        authMode: none
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: database-sink-agent-engine
  - key: sourceUrl
    value: jdbc:postgresql://localhost:5432/source_db
  - key: destUrl
    value: jdbc:mysql://localhost:3306/dest_db
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/database-sink-agent-engine
  needsRebuild: false
