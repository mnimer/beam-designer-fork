nodes:
- id: source-1
  type: pipeline
  position:
    x: 100
    y: 150
  data:
    label: Create
    type: SOURCE
    iconName: Box
    beam_transform: Create
    properties:
      elements:
      - '{"id": 1, "name": "alpha", "score": 99.5}'
      - '{"id": 2, "name": "beta", "score": 88.0}'
    system_instructions: In-memory test batch records.
  width: 180
  height: 62
- id: step-pardo-2
  type: pipeline
  position:
    x: 320
    y: 150
  data:
    label: ParDo
    type: STEP
    iconName: Code
    beam_transform: ParDo
    properties: {}
    system_instructions: Format records into schema-conforming destination records.
  width: 180
  height: 62
- id: sink-3
  type: pipeline
  position:
    x: 540
    y: 150
  data:
    label: JdbcIO
    type: SINK
    iconName: Database
    beam_transform: JdbcIO
    properties:
      driverClassName: org.postgresql.Driver
      url: jdbc:postgresql://localhost:5432/mydb
      username: postgres_user
      table: audit_records
      statement: INSERT INTO audit_records (id, event_type, details) VALUES (?, ?,
        ?)
      autosharding: true
    system_instructions: Insert records into PostgreSQL audit table via parameterized
      JDBC statement.
  width: 180
  height: 62
edges:
- id: edge-source-1-to-step-pardo-2
  source: source-1
  target: step-pardo-2
- id: edge-step-pardo-2-to-sink-3
  source: step-pardo-2
  target: sink-3
runtimeVariables:
- key: ENVIRONMENT
  value: agent-engine
- key: JOB_ID
  value: jdbc-sink-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ''
  subnetwork: ''
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/jdbc-sink-agent-engine
  needsRebuild: false
