nodes:
- id: source-1
  type: pipeline
  position:
    x: 100
    y: 150
  data:
    label: Generate Sequence
    type: SOURCE
    iconName: ListOrdered
    beam_transform: GenerateSequence
    properties:
      from: 1
      to: 500
      ratePerSec: 20
    system_instructions: Emit synthetic numeric sequence for streaming mock data generation.
  width: 180
  height: 62
- id: step-pardo-2
  type: pipeline
  position:
    x: 320
    y: 150
  data:
    label: ParDo Mock Generator
    type: STEP
    iconName: Code
    beam_transform: ParDo
    properties: {}
    system_instructions: Transform integer sequence elements into mock records formatted
      for destination sink.
  width: 180
  height: 62
- id: sink-3
  type: pipeline
  position:
    x: 540
    y: 150
  data:
    label: SQS
    type: SINK
    iconName: Cable
    beam_transform: SqsIO
    properties:
      queueUrl: https://sqs.us-east-1.amazonaws.com/123456789012/outbound-queue
      awsRegion: us-east-1
    system_instructions: Publish queued messages to Amazon SQS outbound queue.
  width: 180
  height: 62
edges:
- id: edge-source-1-to-step-pardo-2
  source: source-1
  target: step-pardo-2
- id: edge-step-pardo-2-to-sink-3
  source: step-pardo-2
  target: sink-3
runtimeVariables:
- key: ENVIRONMENT
  value: cloud-run
- key: JOB_ID
  value: sqs-sink-cloud-run
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ''
  subnetwork: ''
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/sqs-sink-cloud-run
  needsRebuild: false
