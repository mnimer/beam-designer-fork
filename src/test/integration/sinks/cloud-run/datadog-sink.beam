nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        from: 1
        to: 500
        ratePerSec: 20
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo Mock Generator
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform integer sequence elements into mock DatadogEvent
        objects with ddsource apache-beam, ddtags env:prod,team:platform,
        hostname dataflow-worker, and service checkout-service.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: DatadogIO
      type: SINK
      iconName: Activity
      beam_transform: DatadogIO
      properties:
        url: https://http-intake.logs.datadoghq.com
        authMode: secretManager
        apiKeySecret: datadog-logs-api-key
        service: checkout-service
        ddsource: apache-beam
        hostname: dataflow-worker
        ddtags: env:prod,team:platform
        messageField: message
        batchCount: 100
        minBatchCount: 10
        maxBufferSize: 5242880
        parallelism: 4
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: datadog-sink-cloud-run
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/datadog-sink-cloud-run
  needsRebuild: false
