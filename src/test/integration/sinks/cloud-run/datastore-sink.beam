nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: normalize_and_aggregate
      system_instructions: Transform upstream JSON batch records into destination
        records required by DatastoreIO. Process each SensorReading entity,
        extract sensorId and metric values, compute summary aggregations, and
        construct a new Datastore Entity instance under kind 'SensorRollup'. In
        Java, use DoFn<com.google.datastore.v1.Entity,
        com.google.datastore.v1.Entity> to construct new Entity with
        makeKey('SensorRollup', rollupKeyId) and set aggregated property values.
        In Python, parse entity protobuf attributes and construct
        google.cloud.datastore.Entity objects with computed metrics.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Datastore
      type: SINK
      iconName: Database
      beam_transform: DatastoreIO
      properties:
        projectId: my-gcp-project
        databaseId: (default)
        namespace: telemetry
        mutationMode: upsert
        kind: SensorRollup
        keyNameOrIdField: rollupId
        hintNumWorkers: 5
        rampupThrottlingDisabled: false
        authMode: adc
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: datastore-sink-cloud-run
  - key: projectId
    value: my-gcp-project
  - key: databaseId
    value: (default)
  - key: namespace
    value: telemetry
  - key: sourceKind
    value: SensorReading
  - key: sinkKind
    value: SensorRollup
  - key: numQuerySplits
    value: 10
  - key: hintNumWorkers
    value: 5
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/datastore-sink-cloud-run
  needsRebuild: false
