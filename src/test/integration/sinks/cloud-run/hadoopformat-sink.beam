nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: reshape_kv
      system_instructions: Transform upstream JSON batch records into destination
        records required by HadoopFormatIO. Transform incoming KV<LongWritable,
        Text> pairs into output KV<Text, Text> pairs suitable for Hadoop
        TextOutputFormat. In Java, extract the log line Text from
        element.getValue(), parse the timestamp/service header as a new Text key
        (e.g. service name), and emit KV.of(new Text(serviceName), new
        Text(sanitizedLogLine)). In Python, parse the tuple (key, value) and
        output a reshaped key-value tuple (new_key, new_value).
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: HadoopFormat
      type: SINK
      iconName: HardDrive
      beam_transform: HadoopFormatIO
      properties:
        outputFormatClass: org.apache.hadoop.mapreduce.lib.output.TextOutputFormat
        outputKeyClass: org.apache.hadoop.io.Text
        outputValueClass: org.apache.hadoop.io.Text
        outputDir: hdfs://namenode:8020/output/processed_logs
        jobId: beam_hadoop_write_001
        partitioningEnabled: false
        authMode: simple
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: hadoopformat-sink-cloud-run
  - key: inputLocation
    value: hdfs://namenode:8020/data/raw_logs
  - key: outputDir
    value: hdfs://namenode:8020/output/processed_logs
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/hadoopformat-sink-cloud-run
  needsRebuild: false
