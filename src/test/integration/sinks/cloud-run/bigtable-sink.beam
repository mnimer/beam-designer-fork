nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: row_to_mutations
      system_instructions: Transform upstream JSON batch records into destination
        records required by BigTableIO. Transform incoming Bigtable rows of type
        com.google.bigtable.v2.Row into write mutations of type KV<ByteString,
        Iterable<Mutation>>. In Java, implement a
        DoFn<com.google.bigtable.v2.Row, KV<ByteString, Iterable<Mutation>>>
        where row.getKey() provides the key, extract cells from
        row.getFamiliesList(), compute derived metrics, build SetCell mutations
        using
        com.google.bigtable.v2.Mutation.newBuilder().setSetCell(...).build(),
        and output KV.of(rowKey, Collections.singletonList(mutation)). In
        Python, apply a beam.DoFn converting input Bigtable row instances into
        (row_key, [mutation]) tuples compatible with WriteToBigTable.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: BigTable
      type: SINK
      iconName: Database
      beam_transform: BigTableIO
      properties:
        projectId: my-gcp-project
        instanceId: analytics-instance
        tableId: daily_aggregates
        appProfileId: default
        flowControl: true
        authMode: adc
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: bigtable-sink-cloud-run
  - key: projectId
    value: my-gcp-project
  - key: instanceId
    value: analytics-instance
  - key: sourceTableId
    value: raw_events
  - key: sinkTableId
    value: daily_aggregates
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/bigtable-sink-cloud-run
  needsRebuild: false
