nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: documentToWriteMutation
      system_instructions: "Transform upstream JSON batch records into destination
        records required by FirestoreIO. Transform each incoming
        com.google.firestore.v1.Document proto into a
        com.google.firestore.v1.Write proto configured for target collection
        'sink-collection' with set/update mutations. Crucial contract: The
        downstream Java Firestore sink consumes
        PCollection<com.google.firestore.v1.Write> built by this upstream step."
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Firestore
      type: SINK
      iconName: Database
      beam_transform: FirestoreIO
      properties:
        projectId: test-gcp-project
        databaseId: (default)
        targetCollection: sink-collection
        operation: update
        withDeadLetterQueue: true
        batchSize: 50
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: firestore-sink-cloud-run
  - key: projectId
    value: test-gcp-project
  - key: databaseId
    value: (default)
  - key: sourceCollection
    value: source-collection
  - key: targetCollection
    value: sink-collection
  - key: batchSize
    value: 50
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/firestore-sink-cloud-run
  needsRebuild: false
