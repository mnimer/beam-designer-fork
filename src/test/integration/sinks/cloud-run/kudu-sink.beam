nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: EnrichAndAggregateFn
      system_instructions: Transform upstream JSON batch records into destination
        records required by KuduIO. Transform raw sensor telemetry readings by
        grouping readings into summary aggregations with average temperature,
        average humidity, and sample count per device_id. In Java, implement as
        a DoFn<SensorReading, SensorSummary> computing aggregated metrics; in
        Python, implement as a beam.DoFn converting input dictionaries into
        summary records ready for Kudu upsert mutations.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Kudu
      type: SINK
      iconName: Database
      beam_transform: KuduIO
      properties:
        masterAddresses: kudu-master-1:7051,kudu-master-2:7051
        table: sensor_telemetry_summary
        operation: upsert
        flushMode: AUTO_FLUSH_BACKGROUND
        mutationBufferSpace: 10000
        ignoreDuplicateRows: true
        authMode: none
        operationTimeoutMs: 30000
        maxPendingErrors: 100
        batchSize: 1000
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: kudu-sink-cloud-run
  - key: masterAddresses
    value: kudu-master-1:7051,kudu-master-2:7051
  - key: sourceTable
    value: sensor_telemetry_raw
  - key: targetTable
    value: sensor_telemetry_summary
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/kudu-sink-cloud-run
  needsRebuild: false
