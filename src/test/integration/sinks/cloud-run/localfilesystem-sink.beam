nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - record-1,alpha,100
          - record-2,beta,200
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform each CSV line to uppercase and emit the formatted
        String for LocalFileSystem TextIO output.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Local Files Write
      type: SINK
      iconName: Folder
      beam_transform: LocalFileSystem
      properties:
        to: /tmp/beam/output/results
        suffix: .txt
        format: TextIO
        compression: UNCOMPRESSED
        numShards: 1
        shardTemplate: -SSSSS-of-NNNNN
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: localfilesystem-sink-cloud-run
  - key: INPUT_FILE_PATTERN
    value: /tmp/beam/input/*.csv
  - key: OUTPUT_PATH_PREFIX
    value: /tmp/beam/output/results
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/localfilesystem-sink-cloud-run
  needsRebuild: false
