nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Generate Sequence
      type: SOURCE
      iconName: ListOrdered
      beam_transform: GenerateSequence
      properties:
        from: 1
        to: 500
        ratePerSec: 20
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo Mock Generator
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: FormatAsLineProtocolFn
      system_instructions: Transform upstream sequence integers into destination
        records required by InfluxDbIO. Downsample records by 5-minute fixed
        windows, compute aggregate statistics, and format output elements
        strictly into InfluxDB line-protocol strings (e.g.
        'server_downsampled,host=host1 cpu=42.5,mem=71.2 1690000000000000000').
        In Java and Python, output a PCollection<String> matching InfluxDB
        line-protocol specification.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: InfluxDB Sink
      type: SINK
      iconName: Activity
      beam_transform: InfluxDbIO
      properties:
        url: http://influxdb.monitoring.svc.cluster.local:8086
        database: aggregated_metrics
        retentionPolicy: autogen
        consistencyLevel: ONE
        batchSize: 1000
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: influxdb-sink-cloud-run
  - key: url
    value: http://influxdb.monitoring.svc.cluster.local:8086
  - key: sourceDatabase
    value: system_metrics
  - key: sinkDatabase
    value: aggregated_metrics
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/influxdb-sink-cloud-run
  needsRebuild: false
