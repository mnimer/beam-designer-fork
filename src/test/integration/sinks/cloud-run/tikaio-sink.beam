nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"fileLocation": "gs://my-bucket/docs/a.pdf", "content": "Extracted
            text A"}'
          - '{"fileLocation": "gs://my-bucket/docs/b.pdf", "content": "Extracted
            text B"}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate and normalize each extracted document summary JSON
        string and emit it as a String for TextIO.write().
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: TikaIO Write
      type: SINK
      iconName: FileText
      beam_transform: TikaIO
      properties:
        to: gs://my-bucket/extracted/documents
        suffix: .json
        compression: UNCOMPRESSED
        numShards: "5"
        shardTemplate: -SSSSS-of-NNNNN
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: tikaio-sink-cloud-run
  - key: INPUT_DOCS_PATTERN
    value: gs://my-bucket/documents/**/*.pdf
  - key: OUTPUT_DOCS_PREFIX
    value: gs://my-bucket/extracted/documents
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/tikaio-sink-cloud-run
  needsRebuild: false
