nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Create
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        elements:
          - '{"id": 1, "name": "alpha", "score": 99.5}'
          - '{"id": 2, "name": "beta", "score": 88.0}'
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: clean_and_reformat_kv
      system_instructions: Transform upstream JSON batch records into destination
        records required by CdapIO. Process incoming
        PCollection<KV<NullWritable, Text>> from CdapIO Source. Parse the JSON
        string payload in Text, cleanse field values (strip whitespace,
        normalize revenue currency format), and output a transformed
        KV<NullWritable, Text> conforming to the destination CDAP sink schema.
    width: 180
    height: 62
  - id: sink-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: CDAP
      type: SINK
      iconName: Workflow
      beam_transform: CdapIO
      properties:
        pluginType: batch
        cdapPluginClass: io.cdap.plugin.salesforce.plugin.sink.batch.SalesforceBatchSink
        referenceName: SalesforceAccountBatchSink
        keyClass: org.apache.hadoop.io.NullWritable
        valueClass: org.apache.hadoop.io.Text
        locksDirPath: gs://cdap-dataflow-staging/locks/salesforce_sink
        pluginConfig: |-
          consumerKey=salesforce-key
          loginUrl=https://login.salesforce.com
          sObject=Account
          operation=upsert
          upsertKeyName=Id
        batchSize: 1000
        authMode: none
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-3
    source: step-pardo-2
    target: sink-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: cdap-sink-cloud-run
  - key: locksDirPath
    value: gs://cdap-dataflow-staging/locks/salesforce_sink
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/cdap-sink-cloud-run
  needsRebuild: false
