# Author: Mike Nimer <mikenimer@google.com>
# Purpose: Pipeline specification for I19 SNS to SQS Fanout (SnsIO to SqsIO)
nodes:
  - id: "source-sns-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: "SNS"
      type: SOURCE
      iconName: Share2
      beam_transform: SnsIO
      properties:
        topicArn: "arn:aws:sns:us-east-1:123456789012:notifications-fanout"
        sourceQueueUrl: "https://sqs.us-east-1.amazonaws.com/123456789012/sns-subscription-queue"
        region: "us-east-1"
        awsRegion: "us-east-1"
        ingestionMode: "sqs"
      system_instructions: "Consume notifications from SNS topic 'arn:aws:sns:us-east-1:123456789012:notifications-fanout' in region 'us-east-1' via an SQS subscription queue 'https://sqs.us-east-1.amazonaws.com/123456789012/sns-subscription-queue' using sourceQueueUrl option."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-pardo-unpack-2"
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: "ParDo"
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        topicArn: "arn:aws:sns:us-east-1:123456789012:notifications-fanout"
        region: "us-east-1"
      system_instructions: "Unpack SNS message envelope, extract message body and attributes, and filter attributes to validate notification payloads before routing to target SQS queue."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-sqs-3"
    type: pipeline
    position:
      x: 680
      y: 150
    data:
      label: "SQS"
      type: SINK
      iconName: Cable
      beam_transform: SqsIO
      properties:
        queueUrl: "https://sqs.us-east-1.amazonaws.com/123456789012/worker-queue"
        targetQueueUrl: "https://sqs.us-east-1.amazonaws.com/123456789012/worker-queue"
        region: "us-east-1"
        awsRegion: "us-east-1"
        batchSize: 10
      system_instructions: "Publish unpacked messages to Amazon SQS target queue 'https://sqs.us-east-1.amazonaws.com/123456789012/worker-queue' in region 'us-east-1' in batches of 10 using SqsIO.write().withQueueUrl(targetQueueUrl).withBatchSize(batchSize) in Java or cross-language transform in Python."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "e-sns-to-pardo"
    source: "source-sns-1"
    target: "step-pardo-unpack-2"
  - id: "e-pardo-to-sqs"
    source: "step-pardo-unpack-2"
    sourceHandle: valid
    target: "sink-sqs-3"
    targetHandle: null
runtimeVariables:
  - key: JOB_ID
    value: "sns-to-sqs-fanout"
  - key: topicArn
    value: "arn:aws:sns:us-east-1:123456789012:notifications-fanout"
  - key: region
    value: "us-east-1"
  - key: sourceQueueUrl
    value: "https://sqs.us-east-1.amazonaws.com/123456789012/sns-subscription-queue"
  - key: targetQueueUrl
    value: "https://sqs.us-east-1.amazonaws.com/123456789012/worker-queue"
  - key: batchSize
    value: 10
jobConfig:
  runner: "DirectRunner"
  machineType: "n1-standard-1"
  minInstances: 1
  maxInstances: 2
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: "Java"
  outputFolder: "test/sns-to-sqs-fanout"
  needsRebuild: false
