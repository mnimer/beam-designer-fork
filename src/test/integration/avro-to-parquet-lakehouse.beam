# ==============================================================================
# I12: AvroIO to ParquetIO Lakehouse Migration (Java & Python)
# Java Generation & Evaluation: ✅ PASS (100 / 100)
# Explanation: Reads Avro GenericRecords via AvroIO, maps and projects schema fields, and writes Snappy-compressed columnar Parquet files via FileIO / ParquetIO sink adhering to schema specifications.
# Python Generation & Evaluation: ✅ PASS (100 / 100)
# Explanation: Ingests Avro payloads with Fastavro/Beam AvroIO, transforms schemas into dictionaries/dataclasses, and writes partitioned columnar Parquet files with snappy compression.
# ==============================================================================
# Author: Mike Nimer <mikenimer@google.com>
#
# Binary format migration: AvroIO source -> Map schema transformer -> ParquetIO sink with snappy compression.

nodes:
  - id: "source-avro-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: AvroIO
      type: SOURCE
      iconName: FileSpreadsheet
      beam_transform: AvroIO
      properties:
        inputPath: "gs://lakehouse/bronze/*.avro"
        avroSchema: "gs://lakehouse/schemas/bronze.avsc"
      system_instructions: "Read incoming Avro records from 'gs://lakehouse/bronze/*.avro' conforming to schema 'gs://lakehouse/schemas/bronze.avsc' using AvroIO."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-map-projection-2"
    type: pipeline
    position:
      x: 360
      y: 150
    data:
      label: Map
      type: STEP
      iconName: Code
      beam_transform: Map
      properties:
        mappingFunction: "record -> projectToParquetGenericRecord(record)"
        outputType: GenericRecord
      system_instructions: "Project input Avro records into Parquet GenericRecord objects conforming to the silver Lakehouse event schema."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-parquet-3"
    type: pipeline
    position:
      x: 640
      y: 150
    data:
      label: ParquetIO
      type: SINK
      iconName: FileSpreadsheet
      beam_transform: ParquetIO
      properties:
        outputPath: "gs://lakehouse/silver/events"
        compression: "SNAPPY"
        numShards: 5
        schema: |
          {
            "type": "record",
            "name": "SilverEventRecord",
            "namespace": "com.lakehouse.events",
            "fields": [
              {"name": "eventId", "type": "string"},
              {"name": "eventType", "type": "string"},
              {"name": "eventTimestamp", "type": "long"},
              {"name": "payload", "type": "string"}
            ]
          }
      system_instructions: "Write projected records to Parquet files at 'gs://lakehouse/silver/events' with SNAPPY compression and 5 shards using ParquetIO."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "edge-avro-to-map"
    source: "source-avro-1"
    target: "step-map-projection-2"
  - id: "edge-map-to-parquet"
    source: "step-map-projection-2"
    sourceHandle: valid
    target: "sink-parquet-3"
    targetHandle: null
runtimeVariables:
  - key: JOB_ID
    value: avro-to-parquet-lakehouse
  - key: inputPath
    value: "gs://lakehouse/bronze/*.avro"
  - key: outputPath
    value: "gs://lakehouse/silver/events"
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: "gs://lakehouse/staging"
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: "test/avro-to-parquet-lakehouse"
  needsRebuild: false
