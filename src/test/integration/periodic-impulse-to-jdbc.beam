# PeriodicImpulse to JdbcIO Pipeline
# Author: Mike Nimer <mikenimer@google.com>
#
# Periodic trigger ETL: PeriodicImpulse interval source -> ParDo external API caller -> JdbcIO sink.

nodes:
  - id: "source-periodic-impulse-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: PeriodicImpulse
      type: SOURCE
      iconName: Play
      beam_transform: PeriodicImpulse
      properties:
        fireIntervalSeconds: 300
      system_instructions: "Emit periodic impulse signals every 300 seconds (5 minutes) continuously to trigger API polling."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-pardo-fetch-api-2"
    type: pipeline
    position:
      x: 360
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        apiEndpoint: "https://api.example.com/v1/metrics"
        codeGenerationPrompt: "On each periodic trigger, issue an HTTP GET to 'https://api.example.com/v1/metrics', parse JSON metrics, and yield structured row records."
      system_instructions: "Fetch external metrics payload from 'https://api.example.com/v1/metrics' via HTTP GET upon receiving each impulse signal, parsing response into database row elements."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-jdbc-3"
    type: pipeline
    position:
      x: 640
      y: 150
    data:
      label: JdbcIO
      type: SINK
      iconName: Database
      beam_transform: JdbcIO
      properties:
        jdbcUrl: "jdbc:mysql://db.corp:3306/analytics"
        tableName: "periodic_metrics"
        driverClassName: "com.mysql.cj.jdbc.Driver"
        statement: "INSERT INTO periodic_metrics (metric_name, metric_value, recorded_at) VALUES (?, ?, ?)"
      system_instructions: "Write polled metric records into MySQL database table 'periodic_metrics' at 'jdbc:mysql://db.corp:3306/analytics' using parameterized SQL insert."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "edge-impulse-to-pardo"
    source: "source-periodic-impulse-1"
    target: "step-pardo-fetch-api-2"
  - id: "edge-pardo-to-jdbc"
    source: "step-pardo-fetch-api-2"
    sourceHandle: valid
    target: "sink-jdbc-3"
    targetHandle: null
runtimeVariables:
  - key: JOB_ID
    value: periodic-impulse-to-jdbc
  - key: apiEndpoint
    value: "https://api.example.com/v1/metrics"
  - key: jdbcUrl
    value: "jdbc:mysql://db.corp:3306/analytics"
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: "test/periodic-impulse-to-jdbc"
  needsRebuild: false
