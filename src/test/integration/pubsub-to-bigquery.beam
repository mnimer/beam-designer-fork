nodes:
  - id: "source-pubsub-1"
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: PubSub
      type: SOURCE
      iconName: Cable
      beam_transform: PubSubIO
      properties:
        subscription: projects/my-project/subscriptions/telemetry-sub
        timestampAttribute: timestamp
      system_instructions: Read raw telemetry JSON payload from Cloud Pub/Sub subscription with timestamp attribute.
    width: 180
    height: 62
  - id: "step-parse-2"
    type: pipeline
    position:
      x: 350
      y: 150
    data:
      label: Parse Message
      type: STEP
      iconName: Code
      beam_transform: ParseMessage
      properties:
        messageType: JSON
      system_instructions: Parse incoming Pub/Sub message payload as JSON into structured key-value map.
    width: 180
    height: 62
  - id: "step-pardo-validate-3"
    type: pipeline
    position:
      x: 600
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        codeGenerationPrompt: Validate record schema (must contain id, timestamp, metric_name, value). Route valid records to the valid handle and invalid records to the error DLQ handle.
      system_instructions: Route valid parsed telemetry records to the main valid output and malformed or invalid records to the error output collection.
    width: 180
    height: 62
  - id: "sink-bigquery-4"
    type: pipeline
    position:
      x: 880
      y: 100
    data:
      label: BigQuery
      type: SINK
      iconName: Database
      beam_transform: BigQueryIO
      properties:
        dataset: telemetry_dataset
        table: my-project:telemetry_dataset.device_metrics
        createDisposition: beam.io.BigQueryDisposition.CREATE_IF_NEEDED
        writeDisposition: beam.io.BigQueryDisposition.WRITE_APPEND
        method: STORAGE_WRITE_API
        num_storage_api_streams: "0"
      system_instructions: Write valid telemetry records into BigQuery table using the high-performance Storage Write API with CREATE_IF_NEEDED and WRITE_APPEND dispositions. Include proper TableSchema definition.
    width: 180
    height: 62
  - id: "sink-log-dlq-5"
    type: pipeline
    position:
      x: 880
      y: 260
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        logLevel: ERROR
      system_instructions: Log malformed dead-letter elements and parsing errors for audit and alerting.
    width: 180
    height: 62
edges:
  - id: edge-source-to-parse
    source: "source-pubsub-1"
    target: "step-parse-2"
  - id: edge-parse-to-validate
    source: "step-parse-2"
    target: "step-pardo-validate-3"
  - id: edge-validate-to-bq
    source: "step-pardo-validate-3"
    sourceHandle: valid
    target: "sink-bigquery-4"
  - id: edge-validate-to-dlq
    source: "step-pardo-validate-3"
    sourceHandle: error
    target: "sink-log-dlq-5"
runtimeVariables:
  - key: JOB_ID
    value: pubsub-to-bigquery-streaming
  - key: PROJECT_ID
    value: my-project
jobConfig:
  runner: DataflowRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: test/pubsub-to-bigquery
  needsRebuild: false
