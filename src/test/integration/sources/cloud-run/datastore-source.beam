nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Datastore
      type: SOURCE
      iconName: Database
      beam_transform: DatastoreIO
      properties:
        projectId: my-gcp-project
        databaseId: (default)
        namespace: telemetry
        queryMode: kind
        kind: SensorReading
        filter: status = 'ACTIVE'
        numQuerySplits: 10
        authMode: adc
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: normalize_and_aggregate
      system_instructions: Process each SensorReading entity, extract sensorId and
        metric values, compute summary aggregations, and construct a new
        Datastore Entity instance under kind 'SensorRollup'. In Java, use
        DoFn<com.google.datastore.v1.Entity, com.google.datastore.v1.Entity> to
        construct new Entity with makeKey('SensorRollup', rollupKeyId) and set
        aggregated property values. In Python, parse entity protobuf attributes
        and construct google.cloud.datastore.Entity objects with computed
        metrics. Output normalized JSON strings ready for structured downstream
        logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[DatastoreIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: datastore-source-cloud-run
  - key: projectId
    value: my-gcp-project
  - key: databaseId
    value: (default)
  - key: namespace
    value: telemetry
  - key: sourceKind
    value: SensorReading
  - key: sinkKind
    value: SensorRollup
  - key: numQuerySplits
    value: 10
  - key: hintNumWorkers
    value: 5
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/datastore-source-cloud-run
  needsRebuild: false
