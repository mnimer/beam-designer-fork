nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: JsonIO Read Events
      type: SOURCE
      iconName: FileCode
      beam_transform: JsonIO
      properties:
        filePattern: gs://my-bucket/events/incoming-*.json
        lines: true
        compression: AUTO
        schema: |
          {
            "fields": [
              {"name": "event_id", "type": "STRING"},
              {"name": "user_id", "type": "STRING"},
              {"name": "action", "type": "STRING"},
              {"name": "status", "type": "STRING"},
              {"name": "duration_ms", "type": "INT64"},
              {"name": "timestamp", "type": "INT64"}
            ]
          }
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Filter parsed JSON Row elements for active sessions (status
        == SUCCESS and duration_ms > 0) and format each retained row as a string
        for logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[JsonIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: jsonio-source-cloud-run
  - key: filePattern
    value: gs://my-bucket/events/incoming-*.json
  - key: output
    value: gs://my-bucket/events/processed/results
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/jsonio-source-cloud-run
  needsRebuild: false
