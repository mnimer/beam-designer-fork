nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Iceberg Read
      type: SOURCE
      iconName: Database
      beam_transform: IcebergIO
      properties:
        table: lakehouse.events_raw
        catalogName: lakehouse
        catalogType: hadoop
        warehouseLocation: gs://my-lakehouse/iceberg/warehouse
        columnProjection: event_id, timestamp, user_id, action, amount
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate and normalize each Beam Row read from the
        Managed.ICEBERG source table and format a string representation for
        logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[IcebergIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: iceberg-source-cloud-run
  - key: INPUT_ICEBERG_TABLE
    value: lakehouse.events_raw
  - key: OUTPUT_ICEBERG_TABLE
    value: lakehouse.events_processed
  - key: WAREHOUSE_LOCATION
    value: gs://my-lakehouse/iceberg/warehouse
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/iceberg-source-cloud-run
  needsRebuild: false
