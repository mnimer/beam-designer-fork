nodes:
- id: source-1
  type: pipeline
  position:
    x: 100
    y: 150
  data:
    label: SNS
    type: SOURCE
    iconName: Share2
    beam_transform: SnsIO
    properties:
      topicArn: arn:aws:sns:us-east-1:123456789012:system-notifications
      awsRegion: us-east-1
    system_instructions: Consume broadcast alert messages from Amazon Simple Notification
      Service topic.
  width: 180
  height: 62
- id: step-pardo-2
  type: pipeline
  position:
    x: 320
    y: 150
  data:
    label: ParDo
    type: STEP
    iconName: Code
    beam_transform: ParDo
    properties: {}
    system_instructions: Validate, normalize, and extract records into structured
      payload.
  width: 180
  height: 62
- id: sink-log-3
  type: pipeline
  position:
    x: 540
    y: 150
  data:
    label: Log Message
    type: SINK
    iconName: Terminal
    beam_transform: LogMessage
    properties:
      prefix: '[SNS-Log]'
      logField: payload
    system_instructions: Emit structured log for validated elements.
  width: 180
  height: 62
edges:
- id: edge-source-1-to-step-pardo-2
  source: source-1
  target: step-pardo-2
- id: edge-step-pardo-2-to-sink-log-3
  source: step-pardo-2
  target: sink-log-3
runtimeVariables:
- key: ENVIRONMENT
  value: cloud-run
- key: JOB_ID
  value: sns-source-cloud-run
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ''
  subnetwork: ''
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/sns-source-cloud-run
  needsRebuild: false
