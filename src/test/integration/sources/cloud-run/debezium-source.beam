nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: MySQL CDC
      type: SOURCE
      iconName: GitMerge
      beam_transform: DebeziumIO
      properties:
        connectorClass: io.debezium.connector.mysql.MySqlConnector
        hostName: mysql.internal
        port: 3306
        databaseName: inventory
        tableIncludeList: inventory\.orders
        format: json
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: ExtractDebeziumChangeFn
      system_instructions: "Parse the Debezium JSON change envelope, extract the
        operation code ('op': 'c' for create, 'u' for update, 'd' for delete),
        extract the 'after' record snapshot, and produce a KV<String, String> of
        order_id to normalized JSON payload ready for Kafka publishing. Output
        normalized JSON strings ready for structured downstream logging."
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[DebeziumIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: debezium-source-cloud-run
  - key: hostName
    value: mysql.internal
  - key: databaseName
    value: inventory
  - key: bootstrapServers
    value: kafka-broker.internal:9092
  - key: topic
    value: cdc.inventory.orders
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/debezium-source-cloud-run
  needsRebuild: false
