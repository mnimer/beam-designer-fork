nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: ThriftIO Read
      type: SOURCE
      iconName: FileCode
      beam_transform: ThriftIO
      properties:
        filePattern: gs://my-bucket/thrift/raw/*.thrift
        recordClass: com.example.thrift.OrderRecord
        protocolFactory: TBinaryProtocol
        compression: AUTO
        validate: true
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Extract order fields from each deserialized Thrift
        OrderRecord and emit a formatted summary String for logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[ThriftIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: thriftio-source-cloud-run
  - key: INPUT_THRIFT_PATH
    value: gs://my-bucket/thrift/raw/*.thrift
  - key: OUTPUT_THRIFT_PREFIX
    value: gs://my-bucket/thrift/processed/orders
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/thriftio-source-cloud-run
  needsRebuild: false
