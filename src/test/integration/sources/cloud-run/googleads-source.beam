nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: GoogleAdsIO
      type: SOURCE
      iconName: BarChart
      beam_transform: GoogleAdsIO
      properties:
        readMode: read
        customerId: "1234567890"
        loginCustomerId: "9988776655"
        linkedCustomerId: "1122334455"
        query: SELECT campaign.id, campaign.name, metrics.impressions, metrics.clicks,
          metrics.cost_micros FROM campaign WHERE segments.date DURING
          LAST_7_DAYS
        authMode: secretManager
        developerTokenSecret: google-ads-developer-token
        clientSecretSecret: google-ads-client-secret
        refreshTokenSecret: google-ads-refresh-token
        clientId: 123456789-ads.apps.googleusercontent.com
        googleAdsEndpoint: googleads.googleapis.com:443
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Extract campaign.id, campaign.name, metrics.impressions,
        metrics.clicks, and metrics.cost_micros from each GoogleAdsRow into
        structured payload.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[GoogleAdsIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: googleads-source-cloud-run
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/googleads-source-cloud-run
  needsRebuild: false
