nodes:
- id: source-1
  type: pipeline
  position:
    x: 100
    y: 150
  data:
    label: Kinesis
    type: SOURCE
    iconName: Cloud
    beam_transform: KinesisIO
    properties:
      streamName: telemetry-stream
      awsRegion: us-east-1
      initialPosition: LATEST
    system_instructions: Ingest continuous record stream from AWS Kinesis Data Stream.
  width: 180
  height: 62
- id: step-pardo-2
  type: pipeline
  position:
    x: 320
    y: 150
  data:
    label: ParDo
    type: STEP
    iconName: Code
    beam_transform: ParDo
    properties: {}
    system_instructions: Validate, normalize, and extract records into structured
      payload.
  width: 180
  height: 62
- id: sink-log-3
  type: pipeline
  position:
    x: 540
    y: 150
  data:
    label: Log Message
    type: SINK
    iconName: Terminal
    beam_transform: LogMessage
    properties:
      prefix: '[Kinesis-Log]'
      logField: payload
    system_instructions: Emit structured log for validated elements.
  width: 180
  height: 62
edges:
- id: edge-source-1-to-step-pardo-2
  source: source-1
  target: step-pardo-2
- id: edge-step-pardo-2-to-sink-log-3
  source: step-pardo-2
  target: sink-log-3
runtimeVariables:
- key: ENVIRONMENT
  value: cloud-run
- key: JOB_ID
  value: kinesis-source-cloud-run
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ''
  subnetwork: ''
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/kinesis-source-cloud-run
  needsRebuild: false
