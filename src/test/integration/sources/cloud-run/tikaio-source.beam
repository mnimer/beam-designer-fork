nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: TikaIO Parse
      type: SOURCE
      iconName: FileText
      beam_transform: TikaIO
      properties:
        filePattern: gs://my-bucket/documents/**/*.pdf
        contentTypeHint: application/pdf
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Extract the file location, plain text content, and metadata
        from each TikaIO.ParseResult and emit a JSON-formatted String for
        logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[TikaIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: tikaio-source-cloud-run
  - key: INPUT_DOCS_PATTERN
    value: gs://my-bucket/documents/**/*.pdf
  - key: OUTPUT_DOCS_PREFIX
    value: gs://my-bucket/extracted/documents
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/tikaio-source-cloud-run
  needsRebuild: false
