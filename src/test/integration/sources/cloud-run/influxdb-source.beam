nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: InfluxDB Source
      type: SOURCE
      iconName: Activity
      beam_transform: InfluxDbIO
      properties:
        url: http://influxdb.monitoring.svc.cluster.local:8086
        database: system_metrics
        retentionPolicy: autogen
        queryMode: query
        query: SELECT mean(cpu_percent) AS cpu, mean(mem_percent) AS mem FROM
          server_telemetry WHERE time > now() - 6h GROUP BY time(1m), host
        numOfElementsToFetchPerQuery: 1000
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: FormatAsLineProtocolFn
      system_instructions: Downsample records by 5-minute fixed windows, compute
        aggregate statistics, and format output elements strictly into InfluxDB
        line-protocol strings (e.g. 'server_downsampled,host=host1
        cpu=42.5,mem=71.2 1690000000000000000'). In Java and Python, output a
        PCollection<String> matching InfluxDB line-protocol specification.
        Output normalized JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[InfluxDbIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: influxdb-source-cloud-run
  - key: url
    value: http://influxdb.monitoring.svc.cluster.local:8086
  - key: sourceDatabase
    value: system_metrics
  - key: sinkDatabase
    value: aggregated_metrics
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/influxdb-source-cloud-run
  needsRebuild: false
