nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Arrow Flight Source
      type: SOURCE
      iconName: Cable
      beam_transform: ArrowFlightIO
      properties:
        host: flight-source.internal
        port: 47470
        useTls: true
        command: SELECT device_id, temperature, humidity, timestamp FROM telemetry
        authMode: secret_manager
        tokenSecret: flight-source-token
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: filter_and_aggregate
      system_instructions: Process each telemetry Beam Row record, filter anomalies
        where temperature exceeds threshold, enrich with calculated window
        aggregates, and output formatted destination Row records with consistent
        Beam Schema. In Java, implement DoFn<Row, Row>. In Python, apply
        beam.DoFn or FlatMap/Map to transform incoming records into enriched
        output dictionary rows. Output normalized JSON strings ready for
        structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[ArrowFlightIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: cloud-run
  - key: JOB_ID
    value: arrowflight-source-cloud-run
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/cloud-run
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/cloud-run/arrowflight-source-cloud-run
  needsRebuild: false
