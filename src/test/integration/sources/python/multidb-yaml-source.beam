nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: MySQL, PostgreSQL, Oracle, SQL Server
      type: SOURCE
      iconName: Database
      beam_transform: MySQLPostgreSQLOracleSQLServer
      properties:
        databaseType: postgres
        url: jdbc:postgresql://10.20.0.5:5432/sales
        username: beam_reader
        passwordSecret: sales-pg-reader-password
        readMode: query
        query: SELECT order_id, customer_id, order_total, currency, order_ts FROM
          public.orders WHERE order_status = 'SHIPPED'
        fetchSize: 5000
        outputParallelization: true
      system_instructions: "This node is the Beam YAML ReadFromPostgres transform
        (databaseType: postgres, readMode: query). Generate its native
        equivalent: in Java use JdbcIO.readRows() with
        JdbcIO.DataSourceConfiguration.create(\"org.postgresql.Driver\", url)
        plus the Maven dependency org.postgresql:postgresql; in Python use
        apache_beam.io.jdbc.ReadFromJdbc with table_name='public.orders' (a
        required argument; the query takes precedence over it),
        driver_class_name='org.postgresql.Driver' and query=query (the
        PostgreSQL driver is bundled in Beam's expansion service, so no
        classpath is needed). Apply the query, fetchSize (withFetchSize /
        fetch_size) and outputParallelization (withOutputParallelization(true) /
        output_parallelization=True) properties. The password is the payload of
        Secret Manager secret 'sales-pg-reader-password', resolved once at
        pipeline construction per the Credential Handling Rules. Do NOT emit a
        Beam YAML file, YamlTransform, or the JDBC secret_manager option: the
        template SDK versions (Java 2.53.0, Python 2.55.0) predate them. Output
        rows have the fields order_id (INT64), customer_id (STRING), order_total
        (DOUBLE), currency (STRING), order_ts (DATETIME)."
    width: 190
    height: 64
  - id: step-pardo-2
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      system_instructions: "Convert each order row into a normalized USD order summary
        containing order_id, customer_id, order_total_usd (computed as
        order_total * rate using the static rate table {USD: 1.0, EUR: 1.08,
        GBP: 1.27}; for any other currency use rate 1.0 and increment a Beam
        Metrics counter named 'unknown_currency') and order_date (formatted
        yyyy-MM-dd from order_ts), emitted as a JSON string for downstream
        logging. Unit-test the conversion with TestPipeline without connecting
        to PostgreSQL or Secret Manager."
    width: 190
    height: 64
  - id: sink-log-3
    type: pipeline
    position:
      x: 660
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[MySQLPostgreSQLOracleSQLServer-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: python
  - key: JOB_ID
    value: multidb-yaml-source-python
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/python
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Python
  outputFolder: pipelines/python/multidb-yaml-source-python
  needsRebuild: false
