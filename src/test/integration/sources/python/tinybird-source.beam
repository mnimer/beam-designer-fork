nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Tinybird
      type: SOURCE
      iconName: Database
      beam_transform: Tinybird
      properties:
        host: https://api.tinybird.co
        tokenSecret: tinybird-read-token
        queryMode: pipe
        pipeName: web_events_summary
        queryParams: action=purchase
        format: json
      system_instructions: "Because tinybird-beam is ingest-only, implement this
        Tinybird Source as a bounded HTTP API bridge using beam.Create([{}])
        followed by a custom beam.DoFn (ReadFromTinybirdPipeFn) that queries the
        Tinybird Pipes API (GET
        https://api.tinybird.co/v0/pipes/web_events_summary.json with
        params={'action': 'purchase'}) using requests.Session() opened in
        setup() and closed in teardown(). Resolve tokenSecret ONCE at pipeline
        construction with token = _access_secret(project_id,
        'tinybird-read-token') and authenticate with the Authorization: Bearer
        <token> header (never pass the token in the URL or log it). Yield each
        row dict from response.json()['data']. Add requests and
        google-cloud-secret-manager to requirements.txt."
    width: 190
    height: 64
  - id: step-pardo-2
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: Project Summary Row
      type: STEP
      iconName: Code
      beam_transform: ParDo
      system_instructions: Process each Tinybird Pipe row dict, normalize fields
        (session_id, action, event_count), and emit a structured summary dict
        for downstream logging. Unit-test the DoFn with TestPipeline,
        beam.Create and assert_that/equal_to without making HTTP or Secret
        Manager calls.
    width: 190
    height: 64
  - id: sink-log-3
    type: pipeline
    position:
      x: 660
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[Tinybird-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: python
  - key: JOB_ID
    value: tinybird-source-python
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/python
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Python
  outputFolder: pipelines/python/tinybird-source-python
  needsRebuild: false
