nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: TFRecordIO Read
      type: SOURCE
      iconName: FileCode
      beam_transform: TFRecordIO
      properties:
        filePattern: gs://my-bucket/tfrecords/raw/*.tfrecord
        compressionType: AUTO
        validate: true
        coder: BytesCoder
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Decode each TFRecord byte[] payload and emit a
        human-readable summary string for logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[TFRecordIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: python
  - key: JOB_ID
    value: tfrecordio-source-python
  - key: PROJECT_ID
    value: my-project
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/python
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Python
  outputFolder: pipelines/python/tfrecordio-source-python
  needsRebuild: false
