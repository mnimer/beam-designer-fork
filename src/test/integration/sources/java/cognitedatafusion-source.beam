nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Read CDF Maintenance Events
      type: SOURCE
      iconName: Cloud
      beam_transform: CogniteDataFusion
      properties:
        resourceType: events
        project: acme-operations
        baseUrl: https://westeurope-1.cognitedata.com
        authType: clientCredentials
        clientId: 5f1c2a7e-3b4d-4e8f-9a01-23456789abcd
        clientSecretSecret: cdf-ops-client-secret
        authServerUrl: https://login.microsoftonline.com/acme-tenant.onmicrosoft.com/oauth2/v2.0/token
        authScopes: https://westeurope-1.cognitedata.com/.default
        filterParameters: type=maintenance
        appIdentifier: beam-designer-cdf-curation
        readShardsPerWorker: 4
      system_instructions: "Use the community Cognite Beam connector (Maven
        com.cognite:beam-connector-java:0.9.46; add it to pom.xml next to the
        Beam baseline, keep beam.version from the baseline, and add
        org.apache.beam:beam-sdks-java-extensions-protobuf at the same Beam
        version as the baseline, because CDF DTOs such as Event are protobuf
        messages). resourceType \"events\" means CogniteIO.readEvents(),
        producing PCollection<com.cognite.client.dto.Event>. Build
        com.cognite.beam.io.config.ProjectConfig with
        ProjectConfig.create().withProject(project).withBaseUrl(baseUrl).withCl\
        ientId(clientId).withClientSecretFromGcpSecret(GcpSecretConfig.of(optio\
        ns.getProject(),
        clientSecretSecret)).withTokenUrl(authServerUrl).withAuthScopes(authSco\
        pes). authType \"clientCredentials\" means this OAuth2
        client-credentials flow; authServerUrl is the OAuth token endpoint
        passed to withTokenUrl (it is not a secret). clientSecretSecret is a
        Google Cloud Secret Manager secret ID: resolve it ONLY through the
        connector's native GcpSecretConfig
        (com.cognite.beam.io.config.GcpSecretConfig), which reads Secret Manager
        at runtime on the workers; do NOT call the accessSecret helper for this
        node and never put the secret value in code. Apply
        .withProjectConfig(config),
        .withRequestParameters(com.cognite.beam.io.RequestParameters.create().w\
        ithFilterParameter(\"type\", \"maintenance\")) for each key=value line
        in filterParameters,
        .withReaderConfig(com.cognite.beam.io.config.ReaderConfig.create().with\
        AppIdentifier(appIdentifier)) and
        .withHints(com.cognite.beam.io.config.Hints.create().withReadShardsPerW\
        orker(readShardsPerWorker)). Do not use withProjectConfigFile."
    width: 190
    height: 64
  - id: step-pardo-2
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: Curate Events
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        externalIdPrefix: "curated:"
        targetDataSetId: 4521987465213
      system_instructions: Implement a static nested DoFn<Event, String> named
        CurateEventsFn. For each com.cognite.client.dto.Event with a non-empty
        externalId, format a JSON summary string containing externalIdPrefix +
        the original externalId, targetDataSetId, and metadata entry "curatedBy"
        = "beam-designer-cdf-curation" (skip and count with a Beam Counter any
        event without an externalId). In the unit test use TestPipeline,
        Create.of(...) of Event messages built with Event.newBuilder() and
        .withCoder(ProtoCoder.of(Event.class)), and PAssert to check the
        formatted output.
    width: 190
    height: 64
  - id: sink-log-3
    type: pipeline
    position:
      x: 660
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[CogniteDataFusion-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: cognitedatafusion-source-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-2
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/cognitedatafusion-source-java
  needsRebuild: false
