nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: XmlIO
      type: SOURCE
      iconName: FileCode
      beam_transform: XmlIO
      properties:
        filePattern: gs://my-xml-bucket/input/inventory-*.xml
        rootElement: inventory
        recordElement: item
        recordClass: com.example.model.ItemRecord
        charset: UTF-8
        compression: AUTO
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate stock counts on each JAXB ItemRecord read by XmlIO
        and format a summary String for logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[XmlIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: xmlio-source-java
  - key: INPUT_XML_PATH
    value: gs://my-xml-bucket/input/inventory-*.xml
  - key: OUTPUT_XML_PREFIX
    value: gs://my-xml-bucket/output/processed-inventory
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/xmlio-source-java
  needsRebuild: false
