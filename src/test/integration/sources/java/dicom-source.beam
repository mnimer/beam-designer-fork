nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: DicomIO Source
      type: SOURCE
      iconName: Activity
      beam_transform: DicomIO
      properties:
        readMode: dicomSearch
        healthcareDataset: projects/healthcare-project/locations/us-central1/datasets/imaging-dataset
        projectId: healthcare-project
        region: us-central1
        datasetId: imaging-dataset
        dicomStoreId: inbound-dicom-store
        searchType: studies
        bufferSize: 8
        maxWorkers: 5
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate DICOM study metadata attributes (StudyInstanceUID,
        Modality) and extract structured payload.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[DicomIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: dicom-source-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/dicom-source-java
  needsRebuild: false
