nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Elasticsearch
      type: SOURCE
      iconName: Layers
      beam_transform: ElasticsearchIO
      properties:
        addresses: http://localhost:9200
        index: raw_events
        query: '{"query": {"match_all": {}}}'
        scrollKeepalive: 5m
        batchSize: 1000
        authMode: none
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: reshape_events
      system_instructions: Parse and reshape each raw Elasticsearch JSON hit document
        into an aggregated document ready for bulk re-indexing. In Java, parse
        the incoming JSON string with Jackson or org.json, enrich the document
        with an 'ingestion_timestamp' and 'status' = 'PROCESSED', generate a
        deterministic document id, and emit the formatted JSON string. In
        Python, use a beam.DoFn converting the raw JSON string into a Python
        dict, modifying fields, and outputting the serialized JSON string.
        Output normalized JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[ElasticsearchIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: elasticsearch-source-java
  - key: addresses
    value: http://localhost:9200
  - key: sourceIndex
    value: raw_events
  - key: destinationIndex
    value: processed_events
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/elasticsearch-source-java
  needsRebuild: false
