nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Redis
      type: SOURCE
      iconName: Zap
      beam_transform: RedisIO
      properties:
        host: 127.0.0.1
        port: 6379
        database: 0
        readMode: keyPattern
        keyPattern: user:score:*
        batchSize: 1000
        outputParallelization: true
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Transform each incoming KV<String, String> element
        representing a user score. Parse the score value, calculate a derived
        leaderboard score by applying a weight multiplier, and emit a
        transformed KV<String, String> with key prefix 'leaderboard:' and the
        updated score string. In Java, apply a DoFn<KV<String, String>,
        KV<String, String>>. In Python, use beam.ParDo or beam.Map. Output
        normalized JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[RedisIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: redis-source-java
  - key: host
    value: 127.0.0.1
  - key: port
    value: 6379
  - key: keyPattern
    value: user:score:*
  - key: expireTime
    value: 86400000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/redis-source-java
  needsRebuild: false
