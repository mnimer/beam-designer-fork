nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: MongoDB Source
      type: SOURCE
      iconName: Database
      beam_transform: MongoDbIO
      properties:
        uri: mongodb://mongodb.default.svc.cluster.local:27017
        database: ecommerce
        collection: raw_events
        filter: '{"status": "completed"}'
        bucketAuto: true
        numSplits: 4
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: ReshapeDocumentFn
      system_instructions: Extract customerId, compute event metrics and timestamps
        from raw BSON documents, and format each record into an aggregated BSON
        Document with a unique '_id' composite key ('customerId#date') ready for
        upsert into target MongoDB collection. In Java, transform to
        org.bson.Document; in Python, transform dictionary objects. Output
        normalized JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[MongoDbIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: mongodb-source-java
  - key: uri
    value: mongodb://mongodb.default.svc.cluster.local:27017
  - key: database
    value: ecommerce
  - key: sourceCollection
    value: raw_events
  - key: sinkCollection
    value: customer_daily_aggregates
  - key: batchSize
    value: 1024
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/mongodb-source-java
  needsRebuild: false
