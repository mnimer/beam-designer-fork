nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Solr
      type: SOURCE
      iconName: Grid
      beam_transform: SolrIO
      properties:
        zkHost: zk1.internal:2181,zk2.internal:2181/solr
        collection: catalog_raw
        query: "*:*"
        batchSize: 1000
        authMode: none
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: map_documents
      system_instructions: Transform org.apache.solr.common.SolrDocument instances
        into org.apache.solr.common.SolrInputDocument instances for indexing. In
        Java, create a DoFn extracting fields (e.g. 'id', 'title', 'price',
        'category') from each input SolrDocument, apply business logic
        enrichments (e.g. 'indexed_at', 'searchable_text'), create a new
        SolrInputDocument, and call doc.addField(k, v) before emitting. In
        Python, convert Solr input maps to transformed dictionaries with
        required Solr schema fields. Output normalized JSON strings ready for
        structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[SolrIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: solr-source-java
  - key: zkHost
    value: zk1.internal:2181,zk2.internal:2181/solr
  - key: sourceCollection
    value: catalog_raw
  - key: destinationCollection
    value: catalog_search
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/solr-source-java
  needsRebuild: false
