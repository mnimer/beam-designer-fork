nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Web APIs (RequestResponseIO)
      type: SOURCE
      iconName: Cloud
      beam_transform: RequestResponseIO
      properties:
        endpointUrl: https://api.partner-catalog.internal/v1/orders
        httpMethod: GET
        requestCoder: StringUtf8Coder
        responseCoder: JsonUtf8Coder
        authMode: secretManager
        secretName: partner-api-read-token
        authHeaderName: Authorization
        timeout: 30
        enableRepeater: true
        enableThrottler: true
        overloadRatio: 2
        enableCache: true
        redisUri: redis://10.10.0.12:6379
        cacheTtlSeconds: 86400
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate order JSON response payloads and extract structured payload.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[WebAPIs-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: webapis-source-java
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/webapis-source-java
  needsRebuild: false
