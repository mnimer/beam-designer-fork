nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: CDAP
      type: SOURCE
      iconName: Workflow
      beam_transform: CdapIO
      properties:
        pluginType: batch
        cdapPluginClass: io.cdap.plugin.salesforce.plugin.source.batch.SalesforceBatchSource
        referenceName: SalesforceAccountBatchSource
        keyClass: org.apache.hadoop.io.NullWritable
        valueClass: org.apache.hadoop.io.Text
        pluginConfig: |-
          consumerKey=salesforce-key
          loginUrl=https://login.salesforce.com
          query=SELECT Id, Name, AnnualRevenue, CreatedDate FROM Account
        authMode: none
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: clean_and_reformat_kv
      system_instructions: Process incoming PCollection<KV<NullWritable, Text>> from
        CdapIO Source. Parse the JSON string payload in Text, cleanse field
        values (strip whitespace, normalize revenue currency format), and output
        a transformed KV<NullWritable, Text> conforming to the destination CDAP
        sink schema. Output normalized JSON strings ready for structured
        downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[CdapIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: cdap-source-java
  - key: locksDirPath
    value: gs://cdap-dataflow-staging/locks/salesforce_sink
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/cdap-source-java
  needsRebuild: false
