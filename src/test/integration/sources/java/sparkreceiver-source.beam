nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Spark Receiver Source
      type: SOURCE
      iconName: Cpu
      beam_transform: SparkReceiverIO
      properties:
        receiverClass: io.cdap.plugin.salesforce.SalesforceStreamingReceiver
        constructorArgs: |-
          topic=/data/ChangeEvents
          replayFrom=-1
        getOffsetFn: io.cdap.plugin.salesforce.SalesforceOffsetFn
        timestampFn: io.cdap.plugin.salesforce.SalesforceTimestampFn
        valueCoder: org.apache.beam.sdk.coders.StringUtf8Coder
        pullFrequencyMs: 200
        storageLevel: MEMORY_AND_DISK_SER
        restartOnFailure: true
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: ParseSalesforceEventFn
      system_instructions: Parse raw JSON streaming events received from the Spark
        Receiver into structured domain records (KV<String, String>), extracting
        the entity ID as key and payload as value ready for Kafka delivery. In
        Java, implement as DoFn<String, KV<String, String>>; in Python,
        implement as beam.DoFn yielding (key, value) tuples. Output normalized
        JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[SparkReceiverIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: java
  - key: JOB_ID
    value: sparkreceiver-source-java
  - key: receiverClass
    value: io.cdap.plugin.salesforce.SalesforceStreamingReceiver
  - key: bootstrapServers
    value: kafka:9092
  - key: topic
    value: salesforce-events
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/java
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/java/sparkreceiver-source-java
  needsRebuild: false
