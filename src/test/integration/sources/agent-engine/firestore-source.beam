nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Firestore
      type: SOURCE
      iconName: Database
      beam_transform: FirestoreIO
      properties:
        projectId: test-gcp-project
        databaseId: (default)
        collectionId: source-collection
        operation: runQuery
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformFn: documentToWriteMutation
      system_instructions: "Transform each incoming com.google.firestore.v1.Document
        proto into a com.google.firestore.v1.Write proto configured for target
        collection 'sink-collection' with set/update mutations. Crucial
        contract: The downstream Java Firestore sink consumes
        PCollection<com.google.firestore.v1.Write> built by this upstream step.
        Output normalized JSON strings ready for structured downstream logging."
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[FirestoreIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: firestore-source-agent-engine
  - key: projectId
    value: test-gcp-project
  - key: databaseId
    value: (default)
  - key: sourceCollection
    value: source-collection
  - key: targetCollection
    value: sink-collection
  - key: batchSize
    value: 50
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/firestore-source-agent-engine
  needsRebuild: false
