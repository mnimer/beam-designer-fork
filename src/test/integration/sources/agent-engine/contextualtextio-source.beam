nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: ContextualTextIO Read Logs
      type: SOURCE
      iconName: FileText
      beam_transform: ContextualTextIO
      properties:
        filePattern: gs://my-bucket/logs/application-*.log
        delimiter: |+
          
        hasMultilineCSVRecords: false
        compression: AUTO
        hintMatchesManyFiles: true
        emptyMatchTreatment: DISALLOW
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Extract the line text (value) and resourceId from each
        ContextualTextIO Row element, filter for error lines, and format a
        string summary for logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[ContextualTextIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: contextualtextio-source-agent-engine
  - key: filePattern
    value: gs://my-bucket/logs/application-*.log
  - key: output
    value: gs://my-bucket/logs/filtered-errors/output
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/contextualtextio-source-agent-engine
  needsRebuild: false
