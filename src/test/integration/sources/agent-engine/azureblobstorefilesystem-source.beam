nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Azure Blob Read
      type: SOURCE
      iconName: Cloud
      beam_transform: AzureBlobStoreFileSystem
      properties:
        filePattern: azfs://account/container/input/*.parquet
        storageAccount: account
        authMethod: ConnectionString
        connectionString: DefaultEndpointsProtocol=https;AccountName=account;AccountKey=dGVzdGtleQ==;EndpointSuffix=core.windows.net
        format: ParquetIO
        validate: true
        minBundleSize: 67108864
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate, normalize, and format each Parquet record read
        from Azure Blob Storage (azfs://) into a structured string payload for
        logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[AzureBlobStoreFileSystem-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: azureblobstorefilesystem-source-agent-engine
  - key: INPUT_AZURE_PATTERN
    value: azfs://account/container/input/*.parquet
  - key: OUTPUT_AZURE_PREFIX
    value: azfs://account/container/output/results
  - key: AZURE_STORAGE_ACCOUNT
    value: account
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/azureblobstorefilesystem-source-agent-engine
  needsRebuild: false
