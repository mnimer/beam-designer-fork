nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: DynamoDB
      type: SOURCE
      iconName: Database
      beam_transform: DynamoDBIO
      properties:
        tableName: raw_user_events
        awsRegion: us-east-1
        totalSegments: 4
        consistentRead: false
        authMode: default
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: attribute_value_mapping
      system_instructions: Transform DynamoDB AttributeValue items into derived
        records. In Java, implement a DoFn<Map<String, AttributeValue>,
        DerivedEvent> that unpacks AttributeValue fields (e.g., userId =
        item.get("userId").s(), timestamp =
        Long.parseLong(item.get("timestamp").n())), calculates derived event
        metrics, and constructs a DerivedEvent object containing enriched
        attribute mappings. In Python, apply a beam.DoFn or beam.Map function
        extracting string and numeric attributes from the dictionary into a
        formatted derived dictionary. Output normalized JSON strings ready for
        structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[DynamoDBIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: dynamodb-source-agent-engine
  - key: sourceTableName
    value: raw_user_events
  - key: sinkTableName
    value: aggregated_user_events
  - key: awsRegion
    value: us-east-1
  - key: totalSegments
    value: 4
  - key: batchSize
    value: 25
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/dynamodb-source-agent-engine
  needsRebuild: false
