nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Kafka
      type: SOURCE
      iconName: Cable
      beam_transform: KafkaIO
      properties:
        bootstrapServers: kafka-broker:9092
        topic: sensor-events
        keyDeserializer: org.apache.kafka.common.serialization.StringDeserializer
        valueDeserializer: org.apache.kafka.common.serialization.StringDeserializer
        commitOffsetsInFinalize: true
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Validate, normalize, and extract records into structured payload.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[Kafka-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: kafka-source-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/kafka-source-agent-engine
  needsRebuild: false
