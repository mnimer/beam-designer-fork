nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: HL7v2IO Source
      type: SOURCE
      iconName: Activity
      beam_transform: HL7v2IO
      properties:
        readMode: readWithFilter
        healthcareDataset: projects/healthcare-project/locations/us-central1/datasets/hl7v2-dataset
        hl7v2Store: projects/healthcare-project/locations/us-central1/datasets/hl7v2-dataset/hl7V2Stores/inbound-adt-store
        filter: messageType = "ADT"
        initialSplitDuration: PT24H
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Inspect incoming HL7v2Message records, normalize MSH/PID
        segments, and extract structured payload.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[HL7v2IO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: hl7v2-source-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/hl7v2-source-agent-engine
  needsRebuild: false
