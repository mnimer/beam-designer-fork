nodes:
- id: source-1
  type: pipeline
  position:
    x: 100
    y: 150
  data:
    label: JdbcIO
    type: SOURCE
    iconName: Database
    beam_transform: JdbcIO
    properties:
      driverClassName: org.postgresql.Driver
      url: jdbc:postgresql://localhost:5432/mydb
      username: postgres_user
      selectType: query
      query: SELECT id, full_name, email, created_at FROM app_users WHERE active =
        true
    system_instructions: Query relational database table via PostgreSQL JDBC connector.
  width: 180
  height: 62
- id: step-pardo-2
  type: pipeline
  position:
    x: 320
    y: 150
  data:
    label: ParDo
    type: STEP
    iconName: Code
    beam_transform: ParDo
    properties: {}
    system_instructions: Validate, normalize, and extract records into structured
      payload.
  width: 180
  height: 62
- id: sink-log-3
  type: pipeline
  position:
    x: 540
    y: 150
  data:
    label: Log Message
    type: SINK
    iconName: Terminal
    beam_transform: LogMessage
    properties:
      prefix: '[JdbcIO-Log]'
      logField: payload
    system_instructions: Emit structured log for validated elements.
  width: 180
  height: 62
edges:
- id: edge-source-1-to-step-pardo-2
  source: source-1
  target: step-pardo-2
- id: edge-step-pardo-2-to-sink-log-3
  source: step-pardo-2
  target: sink-log-3
runtimeVariables:
- key: ENVIRONMENT
  value: agent-engine
- key: JOB_ID
  value: jdbc-source-agent-engine
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ''
  subnetwork: ''
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/jdbc-source-agent-engine
  needsRebuild: false
