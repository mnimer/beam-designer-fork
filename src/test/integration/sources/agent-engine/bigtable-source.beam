nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: BigTable
      type: SOURCE
      iconName: Database
      beam_transform: BigTableIO
      properties:
        projectId: my-gcp-project
        instanceId: analytics-instance
        tableId: raw_events
        appProfileId: default
        authMode: adc
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: row_to_mutations
      system_instructions: Transform incoming Bigtable rows of type
        com.google.bigtable.v2.Row into write mutations of type KV<ByteString,
        Iterable<Mutation>>. In Java, implement a
        DoFn<com.google.bigtable.v2.Row, KV<ByteString, Iterable<Mutation>>>
        where row.getKey() provides the key, extract cells from
        row.getFamiliesList(), compute derived metrics, build SetCell mutations
        using
        com.google.bigtable.v2.Mutation.newBuilder().setSetCell(...).build(),
        and output KV.of(rowKey, Collections.singletonList(mutation)). In
        Python, apply a beam.DoFn converting input Bigtable row instances into
        (row_key, [mutation]) tuples compatible with WriteToBigTable. Output
        normalized JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[BigTableIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: bigtable-source-agent-engine
  - key: projectId
    value: my-gcp-project
  - key: instanceId
    value: analytics-instance
  - key: sourceTableId
    value: raw_events
  - key: sinkTableId
    value: daily_aggregates
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/bigtable-source-agent-engine
  needsRebuild: false
