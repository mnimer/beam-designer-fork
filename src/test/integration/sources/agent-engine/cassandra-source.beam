nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Cassandra
      type: SOURCE
      iconName: Database
      beam_transform: CassandraIO
      properties:
        hosts: 127.0.0.1
        port: 9042
        keyspace: telemetry
        table: sensor_events
        localDc: datacenter1
        consistencyLevel: LOCAL_QUORUM
        entity: com.example.SensorEvent
        coder: org.apache.beam.sdk.coders.SerializableCoder
        query: WHERE status = 'ACTIVE' ALLOW FILTERING
        authMode: default
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: normalize_and_rollup
      system_instructions: Process each SensorEvent record, normalize timestamp to
        hourly bucket, compute aggregated device telemetry, and map to
        SensorRollup destination entity. In Java, implement a DoFn<SensorEvent,
        SensorRollup> that extracts sensorId, aggregates value metric, formats
        hour_bucket partition key, and outputs new SensorRollup instance. In
        Python, use beam.DoFn or FlatMap/Map to transform incoming row records
        into rollup dictionary/objects ready for Cassandra mutation. Output
        normalized JSON strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[CassandraIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: cassandra-source-agent-engine
  - key: hosts
    value: 127.0.0.1
  - key: port
    value: 9042
  - key: keyspace
    value: telemetry
  - key: sourceTable
    value: sensor_events
  - key: sinkTable
    value: hourly_rollups
  - key: localDc
    value: datacenter1
  - key: batchSize
    value: 100
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/cassandra-source-agent-engine
  needsRebuild: false
