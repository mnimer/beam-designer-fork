nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: HDFS Source
      type: SOURCE
      iconName: HardDrive
      beam_transform: HadoopFileSystem
      properties:
        filePattern: hdfs://namenode:8020/data/logs/*.txt
        namenodeHost: namenode
        namenodePort: 8020
        hdfsUser: beam
        authMechanism: SIMPLE
        configurationResources: /etc/hadoop/conf/core-site.xml,/etc/hadoop/conf/hdfs-site.xml
        format: TextIO
        validate: true
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Retain only log lines read from HDFS (hdfs://) that contain
        the token ERROR and emit each retained line as a String for logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[HadoopFileSystem-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: hadoopfilesystem-source-agent-engine
  - key: INPUT_HDFS_PATTERN
    value: hdfs://namenode:8020/data/logs/*.txt
  - key: OUTPUT_HDFS_PREFIX
    value: hdfs://namenode:8020/output/errors/
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/hadoopfilesystem-source-agent-engine
  needsRebuild: false
