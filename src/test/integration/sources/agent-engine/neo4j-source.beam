nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: Neo4j
      type: SOURCE
      iconName: GitMerge
      beam_transform: Neo4jIO
      properties:
        url: neo4j://127.0.0.1:7687
        database: neo4j
        cypher: MATCH (p:Person)-[:WORKS_AT]->(c:Company) RETURN p.id AS personId,
          p.name AS personName, c.id AS companyId, c.name AS companyName
        rowMapper: org.example.PersonCompanyRowMapper
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties: {}
      system_instructions: Shape each incoming employee-company row into an unwind
        parameter map matching the keys expected by the sink Cypher statement.
        Each output map contains 'personId', 'personName', 'companyId',
        'companyName', and 'timestamp' attributes formatted as Map<String,
        Object> for UNWIND batching. In Java, apply a DoFn<Row, Map<String,
        Object>>. In Python, use beam.Map or beam.ParDo. Output normalized JSON
        strings ready for structured downstream logging.
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[Neo4jIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: neo4j-source-agent-engine
  - key: neo4jUrl
    value: neo4j://127.0.0.1:7687
  - key: database
    value: neo4j
  - key: unwindMapName
    value: rows
  - key: batchSize
    value: 1000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/neo4j-source-agent-engine
  needsRebuild: false
