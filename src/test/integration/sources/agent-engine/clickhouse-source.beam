nodes:
  - id: source-1
    type: pipeline
    position:
      x: 100
      y: 150
    data:
      label: ClickHouse
      type: SOURCE
      iconName: BarChart
      beam_transform: ClickHouseIO
      properties:
        url: jdbc:clickhouse://localhost:8123/default
        driverClassName: com.clickhouse.jdbc.ClickHouseDriver
        database: default
        table: source_events
        query: SELECT id, user_id, action, timestamp, value FROM source_events
        fetchSize: 50000
        authMode: none
    width: 180
    height: 62
  - id: step-pardo-2
    type: pipeline
    position:
      x: 320
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        transformType: shape_to_beam_row
      system_instructions: 'Transform incoming ClickHouse records into a
        PCollection<Row> with an explicit Beam Schema matching the destination
        ClickHouse table columns (id: INT64, user_id: STRING, action: STRING,
        event_time: STRING, metric_value: FLOAT64). In Java, define Schema
        schema =
        Schema.builder().addInt64Field("id").addStringField("user_id").addStringField("action").addStringField("event_time").addDoubleField("metric_value").build(),
        and apply a ParDo converting input elements to Row.withSchema(schema)...
        outputting PCollection<Row>.setRowSchema(schema). In Python, produce
        dicts or named tuples matching the Beam schema for cross-language Row
        serialization. Output normalized JSON strings ready for structured
        downstream logging.'
    width: 180
    height: 62
  - id: sink-log-3
    type: pipeline
    position:
      x: 540
      y: 150
    data:
      label: Log Message
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        prefix: "[ClickHouseIO-Log]"
        logField: payload
    width: 180
    height: 62
edges:
  - id: edge-source-1-to-step-pardo-2
    source: source-1
    target: step-pardo-2
  - id: edge-step-pardo-2-to-sink-log-3
    source: step-pardo-2
    target: sink-log-3
runtimeVariables:
  - key: ENVIRONMENT
    value: agent-engine
  - key: JOB_ID
    value: clickhouse-source-agent-engine
  - key: url
    value: jdbc:clickhouse://localhost:8123/default
  - key: sourceTable
    value: source_events
  - key: sinkTable
    value: destination_events
  - key: maxInsertBlockSize
    value: 100000
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: gs://my-bucket/staging/agent-engine
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: pipelines/agent-engine/clickhouse-source-agent-engine
  needsRebuild: false
