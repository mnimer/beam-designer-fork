# ==============================================================================
# I17: CoGroupByKey Relational Join (Java & Python)
# Java Generation & Evaluation: ✅ PASS (100 / 100)
# Explanation: Joins in-memory Orders and Customers collections on customerId using Beam CoGroupByKey with TupleTags, iterates over CoGbkResult safely in a ParDo to produce enriched records, and outputs text lines to Cloud Storage using TextIO.
# Python Generation & Evaluation: ✅ PASS (100 / 100)
# Explanation: Extracts customerId join keys from in-memory Orders and Customers PCollections, executes a relational CoGroupByKey join, flattens and enriches matching records via ParDo with null-safety, and writes formatted text output to Cloud Storage using WriteToText.
# ==============================================================================
# Author: Mike Nimer <mikenimer@google.com>
# Purpose: Pipeline specification for I17 Multi-Collection Relational Join (Create Sources + CoGroupByKey + ParDo to TextIO)
nodes:
  - id: "source-orders-1"
    type: pipeline
    position:
      x: 80
      y: 80
    data:
      label: "Create Orders"
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        ordersCount: 50
        elements:
          - "{\"orderId\": \"ORD-001\", \"customerId\": \"CUST-10\", \"totalAmount\": 120.50}"
          - "{\"orderId\": \"ORD-002\", \"customerId\": \"CUST-20\", \"totalAmount\": 45.00}"
          - "{\"orderId\": \"ORD-003\", \"customerId\": \"CUST-10\", \"totalAmount\": 85.25}"
      system_instructions: "Generate in-memory test collection of 50 order records with fields orderId, customerId, totalAmount (ordersCount: 50)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "source-customers-2"
    type: pipeline
    position:
      x: 80
      y: 240
    data:
      label: "Create Customers"
      type: SOURCE
      iconName: Box
      beam_transform: Create
      properties:
        customersCount: 20
        elements:
          - "{\"customerId\": \"CUST-10\", \"customerName\": \"Alice Smith\", \"email\": \"alice@example.com\"}"
          - "{\"customerId\": \"CUST-20\", \"customerName\": \"Bob Johnson\", \"email\": \"bob@example.com\"}"
      system_instructions: "Generate in-memory test collection of 20 customer records with fields customerId, customerName, email (customersCount: 20)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-kv-orders-3"
    type: pipeline
    position:
      x: 340
      y: 80
    data:
      label: "KVMapper Orders"
      type: STEP
      iconName: KeyRound
      beam_transform: KVMapper
      properties:
        keyPropertyName: "customerId"
        joinKey: "customerId"
      system_instructions: "Extract customerId as key to produce KV<String, Order> (Java) or (customerId, order) (Python) using joinKey 'customerId'."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-kv-customers-4"
    type: pipeline
    position:
      x: 340
      y: 240
    data:
      label: "KVMapper Customers"
      type: STEP
      iconName: KeyRound
      beam_transform: KVMapper
      properties:
        keyPropertyName: "customerId"
        joinKey: "customerId"
      system_instructions: "Extract customerId as key to produce KV<String, Customer> (Java) or (customerId, customer) (Python) using joinKey 'customerId'."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-cogroupbykey-5"
    type: pipeline
    position:
      x: 600
      y: 160
    data:
      label: "CoGroupByKey"
      type: STEP
      iconName: BarChart
      beam_transform: CoGroupByKey
      properties:
        joinKey: "customerId"
      system_instructions: "Perform CoGroupByKey on order and customer PCollections grouped by common joinKey 'customerId' using KeyedPCollectionTuple.of(ordersTag, ordersKV).and(customersTag, customersKV).apply(CoGroupByKey.create()) in Java or {'orders': orders_kv, 'customers': customers_kv} | beam.CoGroupByKey() in Python."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-pardo-join-6"
    type: pipeline
    position:
      x: 860
      y: 160
    data:
      label: "ParDo Join"
      type: STEP
      iconName: Code
      beam_transform: ParDo
      properties:
        joinKey: "customerId"
        codeGenerationPrompt: "Perform relational inner and left join between orders and customers on customerId (joinKey: 'customerId'). For each customerId key, iterate over joined orders and customers, producing enriched order records with customer name and email. Support graceful handling when customer record is missing."
      system_instructions: "Implement DoFn to iterate through CoGbkResult elements, joining orders with their corresponding customer details on customerId (joinKey: 'customerId'). Format each joined record as JSON string."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-textio-7"
    type: pipeline
    position:
      x: 1120
      y: 160
    data:
      label: "TextIO"
      type: SINK
      iconName: FileText
      beam_transform: TextIO
      properties:
        to: "gs://my-bucket/joined-orders/output"
        outputPath: "gs://my-bucket/joined-orders/output"
        suffix: ".json"
        numShards: 1
      system_instructions: "Write joined relational records to TextIO sink at outputPath 'gs://my-bucket/joined-orders/output' with suffix '.json'."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "e-orders-to-kv"
    source: "source-orders-1"
    target: "step-kv-orders-3"
  - id: "e-customers-to-kv"
    source: "source-customers-2"
    target: "step-kv-customers-4"
  - id: "e-kv-orders-to-cogbk"
    source: "step-kv-orders-3"
    sourceHandle: valid
    target: "step-cogroupbykey-5"
  - id: "e-kv-customers-to-cogbk"
    source: "step-kv-customers-4"
    sourceHandle: valid
    target: "step-cogroupbykey-5"
  - id: "e-cogbk-to-join"
    source: "step-cogroupbykey-5"
    sourceHandle: valid
    target: "step-pardo-join-6"
  - id: "e-join-to-textio"
    source: "step-pardo-join-6"
    sourceHandle: valid
    target: "sink-textio-7"
runtimeVariables:
  - key: JOB_ID
    value: "cogroupbykey-relational-join"
  - key: outputPath
    value: "gs://my-bucket/joined-orders/output"
jobConfig:
  runner: "DirectRunner"
  machineType: "n1-standard-1"
  minInstances: 1
  maxInstances: 2
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: "Java"
  outputFolder: "test/cogroupbykey-relational-join"
  needsRebuild: false
