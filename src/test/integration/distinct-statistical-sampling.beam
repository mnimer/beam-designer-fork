# Author: Mike Nimer <mikenimer@google.com>
# Purpose: Pipeline specification for I18 Distinct and Statistical Sampling (TextIO to LogMessage)
nodes:
  - id: "source-textio-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: "TextIO"
      type: SOURCE
      iconName: FileText
      beam_transform: TextIO
      properties:
        inputFile: "gs://apache-beam-samples/shakespeare/kinglear.txt"
        filePattern: "gs://apache-beam-samples/shakespeare/kinglear.txt"
      system_instructions: "Read lines of text from input file 'gs://apache-beam-samples/shakespeare/kinglear.txt' using TextIO.read().from(inputFile) (Java) or beam.io.ReadFromText(inputFile) (Python)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-distinct-2"
    type: pipeline
    position:
      x: 340
      y: 150
    data:
      label: "Distinct"
      type: STEP
      iconName: BarChart
      beam_transform: Distinct
      properties: {}
      system_instructions: "Deduplicate lines across the PCollection using Distinct.create() (Java) or beam.Distinct() (Python)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-sample-3"
    type: pipeline
    position:
      x: 600
      y: 150
    data:
      label: "Sample"
      type: STEP
      iconName: BarChart
      beam_transform: Sample
      properties:
        sampleSize: 100
        sampleType: "Sample.any"
      system_instructions: "Extract a uniform random sample of 100 elements using Sample.any(100) or Sample.fixedSizeGlobally(100) (Java) or beam.combiners.Sample.FixedSizeGlobally(100) (Python)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-approx-unique-4"
    type: pipeline
    position:
      x: 860
      y: 150
    data:
      label: "Approximate Unique"
      type: STEP
      iconName: BarChart
      beam_transform: ApproximateUnique
      properties:
        sampleSize: 100
        sampleType: "Sample.any"
        estimationPrecision: 0.05
      system_instructions: "Estimate the count of unique elements with estimation precision 0.05 using ApproximateUnique.globally(0.05) (Java) or ApproximateUnique.Globally(0.05) from apache_beam.transforms.stats (Python)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-log-5"
    type: pipeline
    position:
      x: 1120
      y: 150
    data:
      label: "Log Message"
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        logLevel: "INFO"
      system_instructions: "Log the estimated unique sample count to stdout/logger using LogMessage or slf4j/logging."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "e-read-to-distinct"
    source: "source-textio-1"
    target: "step-distinct-2"
  - id: "e-distinct-to-sample"
    source: "step-distinct-2"
    sourceHandle: valid
    target: "step-sample-3"
    targetHandle: null
  - id: "e-sample-to-approx"
    source: "step-sample-3"
    sourceHandle: valid
    target: "step-approx-unique-4"
    targetHandle: null
  - id: "e-approx-to-log"
    source: "step-approx-unique-4"
    sourceHandle: valid
    target: "sink-log-5"
    targetHandle: null
runtimeVariables:
  - key: JOB_ID
    value: "distinct-statistical-sampling"
  - key: inputFile
    value: "gs://apache-beam-samples/shakespeare/kinglear.txt"
  - key: sampleSize
    value: 100
  - key: sampleType
    value: "Sample.any"
  - key: estimationPrecision
    value: 0.05
jobConfig:
  runner: "DirectRunner"
  machineType: "n1-standard-1"
  minInstances: 1
  maxInstances: 2
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: "Java"
  outputFolder: "test/distinct-statistical-sampling"
  needsRebuild: false
