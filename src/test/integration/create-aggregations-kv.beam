# Create Aggregations KV Pipeline
# Author: Mike Nimer <mikenimer@google.com>
#
# In-memory statistical transformations: Create source -> KVMapper -> Top / ApproximateQuantiles / Min / Max -> LogMessage sink.

nodes:
  - id: "source-create-1"
    type: pipeline
    position:
      x: 80
      y: 220
    data:
      label: Create
      type: SOURCE
      iconName: PlusCircle
      beam_transform: Create
      properties:
        staticElements:
          - "itemA:10"
          - "itemB:20"
          - "itemA:30"
          - "itemC:5"
      system_instructions: "Create in-memory PCollection from static list of elements: ['itemA:10', 'itemB:20', 'itemA:30', 'itemC:5']."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-kvmapper-2"
    type: pipeline
    position:
      x: 320
      y: 220
    data:
      label: KVMapper
      type: STEP
      iconName: KeyRound
      beam_transform: KVMapper
      properties:
        keyPropertyName: key
        valuePropertyName: value
      system_instructions: "Parse static string elements into Key-Value pairs with string key and integer value."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-top-3"
    type: pipeline
    position:
      x: 580
      y: 80
    data:
      label: Top
      type: STEP
      iconName: ArrowUpCircle
      beam_transform: Top
      properties:
        topCount: 3
      system_instructions: "Compute top 3 elements per key using Top.largestPerKey(3)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-quantiles-4"
    type: pipeline
    position:
      x: 580
      y: 170
    data:
      label: ApproximateQuantiles
      type: STEP
      iconName: BarChart2
      beam_transform: ApproximateQuantiles
      properties:
        quantilesCount: 5
      system_instructions: "Compute 5 approximate quantiles across values using ApproximateQuantiles."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-min-5"
    type: pipeline
    position:
      x: 580
      y: 260
    data:
      label: Min
      type: STEP
      iconName: Minimize2
      beam_transform: Min
      properties: {}
      system_instructions: "Compute minimum value per key using Min.integersPerKey()."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-max-6"
    type: pipeline
    position:
      x: 580
      y: 350
    data:
      label: Max
      type: STEP
      iconName: Maximize2
      beam_transform: Max
      properties: {}
      system_instructions: "Compute maximum value per key using Max.integersPerKey()."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-log-7"
    type: pipeline
    position:
      x: 840
      y: 220
    data:
      label: "Log Message"
      type: SINK
      iconName: Terminal
      beam_transform: LogMessage
      properties:
        logLevel: INFO
      system_instructions: "Log aggregated statistical results to standard logger output."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "edge-create-to-kv"
    source: "source-create-1"
    target: "step-kvmapper-2"
  - id: "edge-kv-to-top"
    source: "step-kvmapper-2"
    sourceHandle: valid
    target: "step-top-3"
    targetHandle: null
  - id: "edge-kv-to-quantiles"
    source: "step-kvmapper-2"
    sourceHandle: valid
    target: "step-quantiles-4"
    targetHandle: null
  - id: "edge-kv-to-min"
    source: "step-kvmapper-2"
    sourceHandle: valid
    target: "step-min-5"
    targetHandle: null
  - id: "edge-kv-to-max"
    source: "step-kvmapper-2"
    sourceHandle: valid
    target: "step-max-6"
    targetHandle: null
  - id: "edge-top-to-log"
    source: "step-top-3"
    sourceHandle: valid
    target: "sink-log-7"
    targetHandle: null
  - id: "edge-quantiles-to-log"
    source: "step-quantiles-4"
    sourceHandle: valid
    target: "sink-log-7"
    targetHandle: null
  - id: "edge-min-to-log"
    source: "step-min-5"
    sourceHandle: valid
    target: "sink-log-7"
    targetHandle: null
  - id: "edge-max-to-log"
    source: "step-max-6"
    sourceHandle: valid
    target: "sink-log-7"
    targetHandle: null
runtimeVariables:
  - key: JOB_ID
    value: create-aggregations-kv
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 2
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: "test/create-aggregations-kv"
  needsRebuild: false
