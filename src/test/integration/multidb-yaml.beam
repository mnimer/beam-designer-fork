# ==============================================================================
# IO79: MySQL/PostgreSQL/Oracle/SQL Server (Beam YAML ReadFrom*/WriteTo*) (Java & Python)
# Java Generation & Evaluation: (pending first unsandboxed run)
# Python Generation & Evaluation: (pending first unsandboxed run)
# ==============================================================================
# Author: Mike Nimer <mikenimer@google.com>
#
# Cross-database replication: PostgreSQL (Beam YAML ReadFromPostgres) -> ParDo currency
# normalization -> SQL Server (Beam YAML WriteToSqlServer).
# Per project decision D1 the generated project is Java or Python using the native
# equivalent of the Beam YAML JDBC schema transforms (Java JdbcIO / Python
# apache_beam.io.jdbc ReadFromJdbc + WriteToJdbc). Passwords are Google Cloud Secret
# Manager short IDs (passwordSecret); no plaintext credential appears anywhere.

nodes:
  - id: "source-multidb-postgres-1"
    type: pipeline
    position:
      x: 80
      y: 150
    data:
      label: "MySQL, PostgreSQL, Oracle, SQL Server"
      type: SOURCE
      iconName: Database
      beam_transform: MySQLPostgreSQLOracleSQLServer
      properties:
        databaseType: postgres
        url: "jdbc:postgresql://10.20.0.5:5432/sales"
        username: "beam_reader"
        passwordSecret: "sales-pg-reader-password"
        readMode: query
        query: "SELECT order_id, customer_id, order_total, currency, order_ts FROM public.orders WHERE order_status = 'SHIPPED'"
        fetchSize: 5000
        outputParallelization: true
      system_instructions: "This node is the Beam YAML ReadFromPostgres transform (databaseType: postgres, readMode: query). Generate its native equivalent: in Java use JdbcIO.readRows() with JdbcIO.DataSourceConfiguration.create(\"org.postgresql.Driver\", url) plus the Maven dependency org.postgresql:postgresql; in Python use apache_beam.io.jdbc.ReadFromJdbc with table_name='public.orders' (a required argument; the query takes precedence over it), driver_class_name='org.postgresql.Driver' and query=query (the PostgreSQL driver is bundled in Beam's expansion service, so no classpath is needed). Apply the query, fetchSize (withFetchSize / fetch_size) and outputParallelization (withOutputParallelization(true) / output_parallelization=True) properties. The password is the payload of Secret Manager secret 'sales-pg-reader-password', resolved once at pipeline construction per the Credential Handling Rules. Do NOT emit a Beam YAML file, YamlTransform, or the JDBC secret_manager option: the template SDK versions (Java 2.53.0, Python 2.55.0) predate them. Output rows have the fields order_id (INT64), customer_id (STRING), order_total (DOUBLE), currency (STRING), order_ts (DATETIME)."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "step-pardo-normalize-2"
    type: pipeline
    position:
      x: 380
      y: 150
    data:
      label: ParDo
      type: STEP
      iconName: Code
      beam_transform: ParDo
      system_instructions: "Convert each order row into an order-total record with the fields order_id (INT64), customer_id (STRING), order_total_usd (DOUBLE) and order_date (STRING formatted yyyy-MM-dd, taken from order_ts). Compute order_total_usd = order_total * rate using the static rate table {USD: 1.0, EUR: 1.08, GBP: 1.27}; for any other currency use rate 1.0 and increment a Beam Metrics counter named 'unknown_currency'. In Java emit Row objects with an explicit Schema and call setRowSchema on the output PCollection. In Python emit a typing.NamedTuple OrderTotalUsd(order_id: int, customer_id: str, order_total_usd: float, order_date: str), register it with beam.coders.registry.register_coder(OrderTotalUsd, beam.coders.RowCoder) and declare .with_output_types(OrderTotalUsd), so its field order matches the sink statement placeholders 1-to-1."
    width: 190
    height: 64
    selected: false
    dragging: false
  - id: "sink-multidb-sqlserver-3"
    type: pipeline
    position:
      x: 680
      y: 150
    data:
      label: "MySQL, PostgreSQL, Oracle, SQL Server"
      type: SINK
      iconName: Database
      beam_transform: MySQLPostgreSQLOracleSQLServer
      properties:
        databaseType: sqlserver
        url: "jdbc:sqlserver://10.20.0.9:1433;databaseName=analytics;encrypt=true"
        username: "beam_writer"
        passwordSecret: "analytics-mssql-writer-password"
        writeMode: query
        query: "INSERT INTO dbo.order_totals_usd (order_id, customer_id, order_total_usd, order_date) VALUES (?, ?, ?, ?)"
        batchSize: 1000
      system_instructions: "This node is the Beam YAML WriteToSqlServer transform (databaseType: sqlserver, writeMode: query); query is the write statement. Generate its native equivalent: in Java use JdbcIO.<Row>write() with JdbcIO.DataSourceConfiguration.create(\"com.microsoft.sqlserver.jdbc.SQLServerDriver\", url), withStatement(query), withBatchSize(1000) and a PreparedStatementSetter that sets order_id, customer_id, order_total_usd, order_date at indexes 1-4, plus the Maven dependency com.microsoft.sqlserver:mssql-jdbc:12.6.1.jre11. In Python use apache_beam.io.jdbc.WriteToJdbc with table_name='dbo.order_totals_usd', driver_class_name='com.microsoft.sqlserver.jdbc.SQLServerDriver', statement=query, write_batch_size=1000 (the keyword is write_batch_size; WriteToJdbc has no batch_size argument) and classpath=['com.microsoft.sqlserver:mssql-jdbc:12.6.1.jre11']. The password is the payload of Secret Manager secret 'analytics-mssql-writer-password', resolved once at pipeline construction per the Credential Handling Rules. Do NOT emit a Beam YAML file, YamlTransform, or the JDBC secret_manager option."
    width: 190
    height: 64
    selected: false
    dragging: false
edges:
  - id: "edge-postgres-to-pardo"
    source: "source-multidb-postgres-1"
    target: "step-pardo-normalize-2"
  - id: "edge-pardo-to-sqlserver"
    source: "step-pardo-normalize-2"
    target: "sink-multidb-sqlserver-3"
runtimeVariables:
  - key: JOB_ID
    value: multidb-orders-replication
jobConfig:
  runner: DirectRunner
  machineType: n1-standard-1
  minInstances: 1
  maxInstances: 5
  gcsStagingPath: ""
  network: ""
  subnetwork: ""
pipelineConfig:
  language: Java
  outputFolder: "test/multidb-yaml"
  needsRebuild: false
